# Installation-specific + runtime state — never committed to the public core.
# (Per the 2026-07-22 sharing/layering extraction plan: state/ is always
# ignored; loops.toml is the per-installation registry, private-fork-only.)
/state/
/loops.toml

# Real loops are installation policy and live in your own fork, never here.
# Ignoring them by DEFAULT, rather than naming each one, is deliberate: a fork
# that has to edit this file to add a loop has edited a core file, and every
# core file a fork edits is a conflict on some future update. Add loops freely
# — this needs no change. See docs/upstream-updates.md.
/loops/*
!/loops/example/
!/loops/mechanic/

# One estate's backlog is not another's, and the hub appends to this file
# constantly. Untracked here for the same reason as loops.toml: so a fork's
# copy and the core's can never diverge into a conflict.
/docs/ideas.md

# Persona selection is installation policy — which roles your estate has, and
# which sessions wear them. personas/config.example.toml is the committed
# documented form. compiled/ and the persona.md sidecars are generated from it
# by bin/persona-compile, so they are installation-specific too; regenerate
# with --install rather than committing them.
/personas/config.toml
/personas/compiled/
/personas/roles/*
!/personas/roles/example.md
# Unanchored on purpose — a sidecar is written beside every target, wherever
# that target lives. Spelled `**/` so the breadth is stated rather than implied.
**/persona.md

# Python bytecode (bin/dashboard is imported as a module by bin/usage-fetch)
__pycache__/
*.py[cod]

# Flox writes its own .flox/.gitignore for run/cache/lib/log; these are belt-and-
# suspenders in case this repo is opened without that file present.
.flox/run/
.flox/cache/
.flox/lib/
.flox/log/
