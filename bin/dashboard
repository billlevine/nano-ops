import html
import json
import os
import re
import socket
import sqlite3
import subprocess
import sys
import tomllib
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import actors  # noqa: E402  (lib path is established above)
import brief_manifest  # noqa: E402
import estate_deps  # noqa: E402
import estate_events  # noqa: E402
import estate_work  # noqa: E402

STATE = ROOT / "state"
E = html.escape

LEDGER_TAIL = 14          # ledger lines to surface
ACTFIRST_CAP = 12         # PR act-first rows before "+N more"

# Per-PR "you have seen this" marks, written by dashboard-server when the
# operator clicks a row's ✳. Dashboard-owned runtime state (gitignored, like
# every other state/ file); pr-tracker never reads or writes it.
ACKS_FILE = STATE / "dashboard-acks.json"

# Self-contained favicon so the operator can spot the dashboard's browser tab —
# a cat emoji rendered as an inline SVG data-URI. Base64-encoded so the
# multibyte emoji + markup need no attribute escaping; deterministic (fixed
# string) and external-file-free.
_FAVICON_SVG = (
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
    "<text x='50' y='54' font-size='82' text-anchor='middle' "
    "dominant-baseline='central'>🐱</text></svg>"
)
FAVICON = ("data:image/svg+xml;base64,"
           + base64.b64encode(_FAVICON_SVG.encode("utf-8")).decode("ascii"))


# ── generic helpers ──────────────────────────────────────────────────────────

def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return None


def read_json(path: Path):
    txt = read_text(path)
    if txt is None:
        return None
    try:
        return json.loads(txt)
    except json.JSONDecodeError:
        return None


def parse_interval_seconds(s: str) -> int | None:
    m = re.match(r"^\s*(\d+)\s*([smhd])\s*$", s or "")
    if not m:
        return None
    return int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def freshness(age: float | None, interval: int | None) -> str:
    if age is None or interval is None:
        return "na"
    if age < interval:
        return "fresh"
    if age < interval * 2:
        return "aging"
    return "stale"


def human_age(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    s = int(seconds)
    if s < 90:
        return f"{s}s"
    if s < 5400:
        return f"{round(s / 60)}m"
    if s < 172800:
        return f"{round(s / 3600)}h"
    return f"{round(s / 86400)}d"


def human_tokens(n: float | None) -> str:
    n = int(n or 0)
    if n < 1000:
        return str(n)
    if n < 1_000_000:
        return f"{n / 1000:.0f}k" if n >= 100_000 else f"{n / 1000:.1f}k"
    if n < 1_000_000_000:
        return f"{n / 1e6:.0f}M" if n >= 100_000_000 else f"{n / 1e6:.1f}M"
    return f"{n / 1e9:.2f}B"


MODEL_PRETTY = {
    "claude-opus-5": "Opus 5",
    "claude-opus-4-8": "Opus 4.8",
    "claude-sonnet-5": "Sonnet 5",
    "claude-haiku-4-5": "Haiku 4.5",
    "claude-fable-5": "Fable 5",
}


def pretty_model(raw: str | None) -> str:
    if not raw:
        return "—"
    return MODEL_PRETTY.get(raw.strip(), raw.strip())


# ── cost estimate (list pricing, $ per million tokens) ───────────────────────
# Base input/output only; cache-write/read are standard multiples of the base
# input price (Anthropic's published cache economics: 5m write 1.25x, 1h write
# 2x, read 0.1x) rather than four hardcoded numbers per model, so a price
# change only needs the base pair to move. Sonnet 5 is priced at its standard
# (post-intro) rate here; it carries a $2/$10 introductory rate through
# 2026-08-31 — this estimate runs slightly high until then.
MODEL_PRICING_PER_MTOK = {
    "claude-opus-5": {"input": 5.00, "output": 25.00},
    "claude-opus-4-8": {"input": 5.00, "output": 25.00},
    "claude-opus-4-7": {"input": 5.00, "output": 25.00},
    "claude-opus-4-6": {"input": 5.00, "output": 25.00},
    "claude-opus-4-5": {"input": 5.00, "output": 25.00},
    "claude-sonnet-5": {"input": 3.00, "output": 15.00},
    "claude-sonnet-4-6": {"input": 3.00, "output": 15.00},
    "claude-sonnet-4-5": {"input": 3.00, "output": 15.00},
    "claude-haiku-4-5": {"input": 1.00, "output": 5.00},
    "claude-fable-5": {"input": 10.00, "output": 50.00},
    "claude-mythos-5": {"input": 10.00, "output": 50.00},
}
CACHE_WRITE_5M_MULT = 1.25
CACHE_WRITE_1H_MULT = 2.0
CACHE_READ_MULT = 0.1


def _base_model_id(raw: str | None) -> str | None:
    """Strip a trailing dated-snapshot suffix (…-20251001) to the bare id
    used as the MODEL_PRICING_PER_MTOK key. Version numbers themselves may
    contain hyphens (claude-haiku-4-5-20251001 -> claude-haiku-4-5), so this
    only strips the trailing 8-digit date — it does not try to parse the
    rest of the id's structure."""
    if not raw:
        return None
    return re.sub(r"-\d{8}$", "", raw.strip())


def _line_cost_usd(model: str | None, usage: dict) -> float:
    """List-price estimate for one transcript line's usage block. Unknown
    models contribute 0 (excluded from the estimate, not silently wrong)."""
    pricing = MODEL_PRICING_PER_MTOK.get(_base_model_id(model))
    if not pricing:
        return 0.0
    inp = usage.get("input_tokens", 0) or 0
    out = usage.get("output_tokens", 0) or 0
    cc_detail = usage.get("cache_creation") or {}
    cc_1h = cc_detail.get("ephemeral_1h_input_tokens", 0) or 0
    cc_5m = cc_detail.get("ephemeral_5m_input_tokens", 0) or 0
    # Older transcripts may carry only the flat total with no 1h/5m split —
    # treat the unsplit remainder as 5m (the default TTL) rather than
    # dropping it from the estimate.
    cc_total = usage.get("cache_creation_input_tokens", 0) or 0
    cc_unsplit = max(0, cc_total - cc_1h - cc_5m)
    cr = usage.get("cache_read_input_tokens", 0) or 0
    mtok = 1_000_000
    return (
        inp * pricing["input"] / mtok
        + out * pricing["output"] / mtok
        + cc_1h * pricing["input"] * CACHE_WRITE_1H_MULT / mtok
        + (cc_5m + cc_unsplit) * pricing["input"] * CACHE_WRITE_5M_MULT / mtok
        + cr * pricing["input"] * CACHE_READ_MULT / mtok
    )


def _cwd_to_loop(cwd: str | None) -> str:
    """Map a transcript line's cwd to a loop name (matching loops.toml
    [loops.*] dir convention loops/<name>) or "hub" for the repo root /
    "other" for anything outside this repo (e.g. work in other projects)."""
    if not cwd:
        return "other"
    try:
        rel = Path(cwd).resolve().relative_to(ROOT.resolve())
    except (ValueError, OSError):
        return "other"
    parts = rel.parts
    if parts and parts[0] == "loops" and len(parts) > 1:
        return parts[1]
    return "hub"


# ── operator identity (loops.toml [hub]) ─────────────────────────────────────
# Who this installation's hub IS — persona, session title, agent-deck group and
# profile. Never baked into the code: the public core ships neutral defaults and
# every install names itself in its own (gitignored) loops.toml. See
# loops.example.toml.

def hub_config() -> dict:
    """loops.toml [hub]. Never raises — a missing/unparseable registry degrades
    to the neutral defaults below, which is exactly what a fresh clone has."""
    try:
        hub = tomllib.loads(read_text(ROOT / "loops.toml") or "").get("hub", {})
    except tomllib.TOMLDecodeError:
        return {}
    return hub if isinstance(hub, dict) else {}


HUB = hub_config()
# agent-deck title convention is "<persona> (<loop name>)"; the hub's name is "hub".
HUB_PERSONA = HUB.get("persona") or "ops"
HUB_SESSION = HUB.get("session_title") or f"{HUB_PERSONA} (hub)"
# Group every hub-launched session (loops + "ephemeral - …" workers) lands in.
HUB_GROUP = HUB.get("group") or HUB_PERSONA
# Label for this estate, shown in the dashboard header and carried in the JSON.
ESTATE = HUB.get("estate") or "ops"


# ── agent-deck (live session status) ─────────────────────────────────────────

# The loop sessions live under one agent-deck profile (same as the doorbell's
# DOORBELL_DECK_PROFILE). Pass it explicitly so the read works regardless of the
# ambient default profile — in particular under a supervised dashboard-refresh
# service, whose default profile is `default` and would otherwise see nothing.
DECK_PROFILE = (os.environ.get("DASHBOARD_DECK_PROFILE")
                or HUB.get("deck_profile") or "ops")


def deck_ls() -> list[dict]:
    """One `agent-deck ls --json` — the single live-session read for the whole
    snapshot. Read-only; [] on any failure (each lookup then reads as an absent
    session, exactly as a failed per-title `session show` did). The `status` and
    `model` fields here are identical to what `session show` printed, so this
    replaces the former one-`session show`-per-loop sweep with a single call."""
    try:
        r = subprocess.run(
            ["agent-deck", "-p", DECK_PROFILE, "ls", "--json"],
            capture_output=True, text=True, timeout=12,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []
    try:
        data = json.loads(r.stdout)
    except (json.JSONDecodeError, ValueError):
        return []
    return data if isinstance(data, list) else []


def deck_index(sessions: list[dict]) -> dict:
    """Title -> session, for O(1) per-loop lookups off one deck_ls() read."""
    idx: dict = {}
    for s in sessions:
        if isinstance(s, dict) and s.get("title"):
            idx.setdefault(s["title"], s)  # first wins on duplicate titles
    return idx


def deck_session(title: str, index: dict) -> dict:
    """Live status+model for one session title, from a prefetched deck_index().
    Read-only; byte-for-byte the same {present,status,model} the old per-title
    `agent-deck session show` produced (verified: ls `status`/`model` equal the
    Status:/Model: lines show printed)."""
    s = index.get(title)
    if not s:
        return {"present": False, "status": None, "model": None}
    status = s.get("status")
    status = status.lower() if isinstance(status, str) and status else None
    return {"present": True, "status": status, "model": s.get("model") or None}


# ── ephemeral queue (hub sessions dispatched RIGHT NOW) ──────────────────────
# What is in flight this moment — distinct from the night-shift queue (which is
# QUEUED PR/task work). The hub names each dispatched worker "ephemeral - <slug>"
# under HUB_GROUP; one `agent-deck ls --json` read surfaces them all.
# Read-only; never mutates a session.

EPH_PREFIX = "ephemeral - "
EPH_ORDER = {"running": 0, "waiting": 1, "idle": 2}


def build_ephemeral(now: datetime, sessions: list[dict]) -> list[dict]:
    dispatches = read_json(STATE / "hub" / "dispatches.json")
    if not isinstance(dispatches, dict):
        dispatches = {}
    out = []
    for s in sessions:
        if not isinstance(s, dict):
            continue
        title = s.get("title") or ""
        if s.get("group") != HUB_GROUP or not title.startswith(EPH_PREFIX):
            continue
        slug = title[len(EPH_PREFIX):].strip() or title
        ca = s.get("created_at")
        age = None
        if ca:
            try:
                age = max(0.0, now.timestamp() - datetime.fromisoformat(ca).timestamp())
            except ValueError:
                age = None
        item = {
            "slug": slug, "status": (s.get("status") or "").lower(),
            "substate": s.get("substate"), "age": age,
            "path": s.get("path"), "id": s.get("id"),
        }
        dispatch = dispatches.get(EPH_PREFIX + slug)
        if isinstance(dispatch, dict):
            for field in ("kind", "ref", "task_id"):
                if dispatch.get(field) is not None:
                    item[field] = dispatch[field]
        out.append(item)
    # running first, then longest-alive first — the ones burning time now on top
    out.sort(key=lambda x: (EPH_ORDER.get(x["status"], 3), -(x["age"] or 0)))
    return out


# ── loops (registry + heartbeat + live session) ──────────────────────────────

def build_loops(registry: dict, now: float, index: dict) -> list[dict]:
    loops = []

    def heartbeat(name: str):
        raw = read_text(STATE / name / "last_tick")
        if not raw or not raw.strip().isdigit():
            return None, None
        tick = int(raw.strip())
        return tick, max(0.0, now - tick)

    # hub — the operator; not in [loops.*]
    tick, age = heartbeat("hub")
    hub_sess = deck_session(HUB_SESSION, index)
    db_raw = read_text(STATE / "hub" / "doorbell_alive")
    db_tick = int(db_raw.strip()) if db_raw and db_raw.strip().isdigit() else None
    db_age = max(0.0, now - db_tick) if db_tick is not None else None
    loops.append({
        "name": "hub", "persona": HUB_PERSONA, "interval": "≈30s poll",
        "interval_seconds": 90, "model": None, "model_pretty": "operator",
        "autostart": True, "is_hub": True,
        "last_tick": tick, "heartbeat_age": age,
        # hub is event-driven (doorbell kicks it on DM activity), not on a fixed
        # interval — a quiet-period gap isn't a fault; liveness is the live session.
        "freshness": freshness(age, 600),
        "session_present": hub_sess["present"], "session_status": hub_sess["status"],
        "live_model": hub_sess["model"], "role": "operator — routes the control channel",
        # doorbell liveness is a separate signal from last_tick: the poller
        # stamps this file every ~30s regardless of hub activity, so it stays
        # fresh through a long idle backstop that would make last_tick stale.
        "doorbell_tick": db_tick, "doorbell_age": db_age,
        "doorbell_alive": db_age is not None and db_age < 90,
    })

    # A loop's one-line role is registry data, not code: [loops.<name>].role in
    # loops.toml. A table of hardcoded descriptions here would be one
    # installation's loop set baked into a shared renderer.
    for name, cfg in (registry.get("loops") or {}).items():
        persona = cfg.get("persona", name)
        interval = cfg.get("interval", "")
        isec = parse_interval_seconds(interval)
        tick, age = heartbeat(name)
        sess = deck_session(f"{persona} ({name})", index)
        loops.append({
            "name": name, "persona": persona, "interval": interval,
            "interval_seconds": isec, "model": cfg.get("model"),
            "model_pretty": pretty_model(cfg.get("model")),
            "autostart": bool(cfg.get("autostart")), "is_hub": False,
            "last_tick": tick, "heartbeat_age": age,
            "freshness": freshness(age, isec),
            "session_present": sess["present"], "session_status": sess["status"],
            "live_model": sess["model"], "role": cfg.get("role", ""),
        })
    return loops


# ── PR board (reads the tracker's own classification) ────────────────────────

BUCKET_OF = {"me": "waiting_you", "my_review": "my_review",
             "reviewers": "on_reviewers", "forge": "in_progress"}

# Estate task kinds that mean "a worker is actively reworking this PR". Kept to
# an explicit list rather than "any task with refs.pr", and that distinction
# matters more since P-01 made shared identity mandatory: pr-reviewer now files
# a `pr-review` task carrying `refs.pr` for everything merely *queued* for
# tonight. Queued is a different claim from in-flight and must not quiet a row
# that still needs the operator.
PR_WORK_KINDS = ("pr-action",)
# Non-terminal statuses that still mean the store owns the work. `blocked` and
# `needs-owner` are deliberate parks that hand the PR straight back to the
# operator, so they belong in their court, not in "in progress".
PR_WORK_STATUSES = ("open", "ready", "claimed")


def split_note(note: str | None) -> tuple[str | None, str]:
    """Split a manual note into its leading YYYY-MM-DD date (if any) and body."""
    m = re.match(r"^\s*(\d{4}-\d{2}-\d{2})\s*[:·—-]\s*(.*)$", note or "", re.S)
    if m:
        return m.group(1), re.sub(r"\s+", " ", m.group(2)).strip()
    return None, re.sub(r"\s+", " ", note or "").strip()


def activity_sig(entry: dict) -> tuple[str, str | None]:
    """Fingerprint one pr-tracker entry's activity, plus when it last moved.

    Built only from signals pr-tracker already records — GitHub's own
    ``updatedAt`` (which moves on any commit/comment/review/label), the review
    and check verdicts, the comment count, the issue tracker's
    status/``updatedAt``, the operator's manual note, and the tracker's own classification. Deliberately excludes
    everything time-derived (``idle_days``, ``age_days``, ``last_seen``) and the
    fields that flap to UNKNOWN between scans (``mergeable``,
    ``mergeStateStatus``), so a genuinely quiet PR keeps a stable signature for
    as long as it stays quiet — that stability is what makes an acknowledgment
    last. Returns (signature, last-activity ISO timestamp or None).
    """
    pr = entry.get("pr") or {}
    lin = entry.get("linear") or {}
    der = entry.get("derived") or {}
    parts = [
        pr.get("updatedAt"), pr.get("state"), pr.get("isDraft"),
        pr.get("reviewDecision"), pr.get("comments"), pr.get("checks"),
        lin.get("updatedAt"), lin.get("status"),
        (entry.get("manual") or {}).get("note"),
        der.get("waiting_on"), sorted(der.get("flags") or []),
    ]
    blob = json.dumps(parts, sort_keys=True, default=str)
    sig = hashlib.sha1(blob.encode("utf-8")).hexdigest()[:12]
    stamps = [s for s in (pr.get("updatedAt"), lin.get("updatedAt")) if s]
    return sig, (max(stamps) if stamps else None)


def read_acks() -> dict:
    """{entry id -> acknowledged activity signature}. Absent file = nothing acked."""
    doc = read_json(ACKS_FILE) or {}
    acks = doc.get("acks")
    if not isinstance(acks, dict):
        return {}
    return {k: v.get("sig") for k, v in acks.items() if isinstance(v, dict)}


def active_pr_work() -> dict:
    """{PR key -> estate task id} for PRs a worker is on RIGHT NOW.

    ``derive()`` in pr-tracker is re-computed from live GitHub state every run,
    and GitHub never lets an author hold a formal review decision on their own
    PR — so one of the operator's own PRs with self-review comments reads
    ``waiting_on: "me"`` both before anyone touches it and while a dispatched
    worker is actively fixing it. Nothing in GitHub's
    data distinguishes the two. The estate's shared task store does: the hub
    files a ``pr-action`` task when it dispatches the rework worker and closes
    it when it collects the result, so a live task IS the missing signal.

    Reads ``state/estate.db`` directly, the same read-only shape
    ``build_estate_activity`` and ``bin/dashboard-index`` already use. Any
    failure — absent DB, locked, schema drift — degrades to "nothing is in
    flight", which is the pre-P-33 behavior, never an error page.
    """
    out: dict[str, str] = {}
    db = STATE / "estate.db"
    if not db.exists():
        return out
    kinds = ",".join("?" * len(PR_WORK_KINDS))
    statuses = ",".join("?" * len(PR_WORK_STATUSES))
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
        rows = conn.execute(
            f"SELECT id, refs FROM tasks WHERE kind IN ({kinds}) "
            f"AND status IN ({statuses}) ORDER BY seq",
            (*PR_WORK_KINDS, *PR_WORK_STATUSES)).fetchall()
        conn.close()
    except sqlite3.Error:
        return out
    for task_id, refs in rows:
        try:
            parsed = json.loads(refs or "{}")
        except (json.JSONDecodeError, TypeError):
            continue
        key = parsed.get("pr") if isinstance(parsed, dict) else None
        if isinstance(key, str) and key:
            out[key] = task_id      # last (highest seq) task wins
    return out


SPOTTER_UNOBSERVED = "unobserved"


def pr_freshness(entry: dict) -> dict:
    """How old this row's numbers are, and whether the spotter is holding it.

    Gap audit P-03. `merge_state` no longer archives an item just because a
    fetch failed — it carries the previous entry forward untouched and stamps
    it. That makes a held row indistinguishable from a live one by inspection,
    so the stamp travels onto EVERY row here, not only the held ones.

    `last_seen` is the pre-P-03 spelling of the same fact and is the fallback
    for state an older spotter wrote: it only ever advanced on a refresh that
    had the entry in hand.
    """
    obs = entry.get("observation") or {}
    held = obs.get("status") == SPOTTER_UNOBSERVED
    return {
        "last_successful_observation_at": (
            entry.get("last_successful_observation_at")
            or entry.get("last_seen")),
        "unobserved": held,
        "unobserved_misses": obs.get("misses") if held else None,
        "unobserved_sources": list(obs.get("sources") or []) if held else [],
        "unobserved_outcome": obs.get("outcome") if held else None,
    }


def build_pr_board() -> dict:
    st = read_json(STATE / "pr-tracker" / "state.json") or {}
    entries = st.get("entries", {})
    acked = read_acks()
    working = active_pr_work()
    buckets = {"going_astray": 0, "waiting_you": 0, "my_review": 0,
               "on_reviewers": 0, "in_progress": 0}
    act_first = []
    notes_other = []
    snoozed = 0
    for eid, e in entries.items():
        der = e.get("derived", {}) or {}
        # `track.py snooze <id> <days>` already drops an entry from pr-tracker's
        # own active view, buckets and counts (track.py:1453). The board read
        # none of it until the ack path existed — suppression existed and the
        # surface he actually looks at ignored it.
        if der.get("snoozed"):
            snoozed += 1
            continue
        flags = der.get("flags", []) or []
        wait = der.get("waiting_on")
        pr = e.get("pr") or {}
        lin = e.get("linear") or {}
        key = pr.get("key")
        # A live estate task outranks every derived bucket: whatever GitHub says
        # the PR is waiting on, somebody is on it, so it is not the operator's move.
        # That includes `astray` — a PR with a worker attached is not stalled.
        task = working.get(key) if key else None
        astray = "astray" in flags and not task
        if task:
            buckets["in_progress"] += 1
        elif astray:
            buckets["going_astray"] += 1
        elif wait in BUCKET_OF:
            buckets[BUCKET_OF[wait]] += 1
        # The operator's memory-trail note — the last manual action per PR.
        note = (e.get("manual") or {}).get("note") or None
        title = pr.get("title") or lin.get("title") or eid
        url = pr.get("url") or lin.get("url") or ""
        repo = pr.get("repo") or (key.split("#")[0] if key else "")
        number = pr.get("number")
        sig, moved_at = activity_sig(e)
        rec = {
            "id": eid, "key": key, "url": url, "title": title,
            "repo": repo, "number": number, "note": note,
            "idle_days": der.get("idle_days"), "age_days": der.get("age_days"),
            "comments": pr.get("comments"), "flags": flags,
            "linear_id": lin.get("id"), "project": lin.get("project"),
            "astray": astray, "waiting_on": wait,
            # waiting_on stays the honest derived value; in_progress is the
            # override the board renders on, with the task id as its evidence.
            "in_progress": bool(task), "estate_task": task,
            # Unseen until the operator has acknowledged *this* signature. One they have
            # never acked reads as unseen, which is the honest default.
            "sig": sig, "activity_at": moved_at, "unseen": acked.get(eid) != sig,
            # P-03: on every row, live or held. See pr_freshness().
            **pr_freshness(e),
        }
        # act-first = things in *our* court: astray (nudge) + waiting-on-you,
        # minus anything a worker currently owns.
        if task:
            if note:
                notes_other.append(rec)
        elif astray or wait == "me":
            act_first.append(rec)
        elif note:
            # noted PR that won't get an act-first row — still surface its note
            # so the last action per PR stays visible.
            notes_other.append(rec)
    # astray first (idle in someone else's court, most stale), then oldest-idle
    act_first.sort(key=lambda r: (not r["astray"], -(r["idle_days"] or 0)))
    # other noted PRs newest-note first (notes lead with an ISO date)
    notes_other.sort(key=lambda r: r["note"] or "", reverse=True)

    # board metadata from DASHBOARD.md header
    md = read_text(STATE / "pr-tracker" / "DASHBOARD.md") or ""
    meta = {"updated": None, "active": None, "ignored": None, "scanning": None}
    m = re.search(r"_Updated (.+?) UTC · (\d+) active · (\d+) ignored · scanning (.+?)_", md)
    if m:
        meta = {"updated": m.group(1) + " UTC", "active": int(m.group(2)),
                "ignored": int(m.group(3)), "scanning": m.group(4)}
    # P-03, board-level: how much of the board is a held copy, and which source
    # the spotter could not read. Counted over every entry, including the ones
    # that never earn a row — a blind spot is not less real for landing on a
    # PR that is quietly waiting on reviewers.
    held = [eid for eid, e in entries.items()
            if (e.get("observation") or {}).get("status") == SPOTTER_UNOBSERVED]
    unreadable = sorted(
        ({"source": r.get("source"), "outcome": r.get("outcome")}
         for r in (st.get("sources") or {}).values()
         if isinstance(r, dict) and not r.get("ok")),
        key=lambda r: str(r["source"]))
    return {"buckets": buckets, "act_first": act_first,
            "notes_other": notes_other, "meta": meta, "snoozed": snoozed,
            "in_progress_tasks": working,
            "unobserved": len(held), "unobserved_ids": sorted(held),
            "unreadable_sources": unreadable}


# ── night-shift queue + last-night report ────────────────────────────────────

# `failed` sorts right behind `needs-you` (P-04): both are outcomes somebody
# has to look at, and an unranked status would fall to the bottom of the card.
STATUS_RANK = {"needs-you": 0, "failed": 1, "queued": 2, "in-progress": 3,
               "running": 3, "done": 4}


def build_night() -> dict:
    q = read_json(STATE / "pr-reviewer" / "queue.json") or {}
    items = []
    for iid, it in (q.get("items") or {}).items():
        kind = it.get("kind", "pr")
        title = it.get("title") or it.get("description") or iid
        items.append({
            "id": iid, "kind": kind, "title": title,
            "status": it.get("status", "queued"),
            "reason": it.get("queued_reason") or it.get("context"),
            "linear": it.get("linear"), "review_url": it.get("review_url"),
        })
    items.sort(key=lambda r: (STATUS_RANK.get(r["status"], 5), r["id"]))

    report = {"date": None, "done": None, "needs_you": None, "failed": None}
    nr = read_text(STATE / "pr-reviewer" / "NIGHT-REPORT.md") or ""
    dm = re.search(r"night report \((.+?)\)", nr)
    if dm:
        report["date"] = dm.group(1)
    # One pattern per count, not one pattern spanning them: the report's count
    # line is alphabetical, so `failed` now lands BETWEEN done and needs-you
    # (P-04) and a single spanning regex silently matched nothing.
    for key, label in (("done", "done"), ("needs_you", "needs-you"),
                       ("failed", "failed")):
        found = re.search(rf"\*\*{re.escape(label)}\*\*\s*(\d+)", nr)
        if found:
            report[key] = int(found.group(1))
    return {"queue": items, "report": report}


# ── focus projects (momentum cards) ──────────────────────────────────────────

def build_focus() -> dict:
    """Read the focus-projects engine's data model (state/focus/focus.json).
    Pure consumer — the focus engine owns all issue-tracker access + scoring;
    the dashboard only renders. Absent/empty file => not available."""
    model = read_json(STATE / "focus" / "focus.json")
    if not model or not model.get("projects"):
        return {"available": False, "projects": []}
    # The engine's generated model is intentionally focused on momentum data;
    # its small declaration file remains authoritative for project URLs. Join
    # those URLs by stable project key for consumers that want navigation.
    urls = {}
    projects_file = STATE / "focus" / "projects.toml"
    try:
        with projects_file.open("rb") as f:
            declared = tomllib.load(f).get("projects", {})
        urls = {key: p.get("url") for key, p in declared.items()
                if isinstance(p, dict) and p.get("url")}
    except (OSError, tomllib.TOMLDecodeError):
        pass
    projects = [{**p, "url": urls.get(p.get("key"))}
                for p in model.get("projects", [])]
    return {"available": True, "generated_at": model.get("generated_at"),
            "batch_cap": model.get("batch_cap"),
            "projects": projects}


# ── morning brief (recent reports; latest retained for snapshot consumers) ──

def brief_delivery(date: str) -> dict | None:
    """Did this date's brief reach Slack? (gap audit P-10.)

    The report file on disk says a brief was WRITTEN. Until the publication
    record existed, nothing said whether the operator ever received it — a relay that
    failed looked exactly like one that worked, from here. Read-only, and a
    missing/unreadable record degrades to None rather than claiming anything.
    """
    data = read_json(STATE / "morning-brief" / "publications.json")
    if not isinstance(data, dict):
        return None
    rec = (data.get("dates") or {}).get(date)
    if not isinstance(rec, dict):
        return None
    dlv = rec.get("delivery") or {}
    gen = rec.get("generation") or {}
    return {"generation": gen.get("status"), "status": dlv.get("status"),
            "delivered_at": dlv.get("delivered_at"),
            "reason": dlv.get("reason"),
            "attempts": len(dlv.get("attempts") or [])}


def spotter_snapshot_now() -> str | None:
    """The content hash of the spotter board AS IT IS NOW.

    Not a freshness opinion — one number, compared against the one the brief's
    manifest recorded. The PR-board panel above is live on purpose (it answers
    "what is true now"), and the digest panel is a morning's snapshot; before
    P-11 the two could show different boards with nothing saying so.
    """
    try:
        return hashlib.sha256(
            (STATE / "pr-tracker" / "state.json").read_bytes()).hexdigest()
    except OSError:
        return None


def brief_manifest_for(date: str) -> dict:
    """What the brief for `date` could see (gap audit P-11).

    Read through lib/brief_manifest so the reader and the writer share one
    vocabulary, and so a report with no manifest — every one written before
    P-11 — gets the legacy stub rather than nine invented `completed` sources.
    """
    return brief_manifest.load(STATE / "morning-brief", date)


def build_brief() -> dict:
    reports = sorted(glob.glob(str(STATE / "morning-brief" / "reports" / "*.md")))
    if not reports:
        return {"available": False, "reports": []}
    recent = []
    for report in reversed(reports[-5:]):
        path = Path(report)
        recent.append({"name": path.name, "date": path.stem,
                       "body": read_text(path) or "",
                       "delivery": brief_delivery(path.stem),
                       "manifest": brief_manifest_for(path.stem)})
    latest = recent[0]
    snapshot = (latest["manifest"].get("spotter_snapshot") or {}).get("sha256")
    live = spotter_snapshot_now()
    return {"available": True, "name": latest["name"],
            "body": latest["body"], "delivery": latest["delivery"],
            "manifest": latest["manifest"],
            # True only when BOTH hashes are known and differ. Unknown is not
            # drift: a legacy manifest and an unreadable board both mean we
            # cannot compare, and saying "the board moved" on that would be
            # the same invented finding P-03 removed from the spotter.
            "board_moved": bool(snapshot and live and snapshot != live),
            "reports": recent}


# ── mechanic proposals ───────────────────────────────────────────────────────

def build_mechanic() -> dict:
    md = read_text(STATE / "mechanic" / "REPORT.md")
    if md is None:
        return {"date": None, "proposals": [], "applied": None, "observations": []}
    date = None
    dm = re.search(r"night of (.+)", md.splitlines()[0]) if md.splitlines() else None
    if dm:
        date = dm.group(1).strip()

    # split into H2 sections
    sections: dict[str, list[str]] = {}
    cur = None
    for line in md.splitlines():
        h = re.match(r"^##\s+(.+?)\s*$", line)
        if h:
            cur = h.group(1)
            sections[cur] = []
        elif cur is not None:
            sections[cur].append(line)

    def section(key_sub):
        for k, v in sections.items():
            if key_sub.lower() in k.lower():
                return v
        return []

    def bullets(lines):
        out, buf = [], None
        for ln in lines:
            if re.match(r"^-\s+", ln):
                if buf is not None:
                    out.append(buf)
                buf = ln
            elif buf is not None and ln.strip():
                buf += " " + ln.strip()
            elif buf is not None and not ln.strip():
                out.append(buf)
                buf = None
        if buf is not None:
            out.append(buf)
        return [re.sub(r"\s+", " ", b).strip() for b in out]

    proposals = []
    for b in bullets(section("Proposals")):
        m = re.match(r"^-\s+\*\*(.+?)\*\*\s*(.*)$", b)
        if m:
            head, body = m.group(1), m.group(2)
            tm = re.match(r"^(P\d+)\s*[—-]\s*(.+)$", head)
            tag = tm.group(1) if tm else None
            title = tm.group(2).rstrip(".") if tm else head
        else:
            tag, title, body = None, re.sub(r"^-\s+", "", b), ""
        proposals.append({"tag": tag, "title": title, "body": body})

    obs = [re.sub(r"^-\s+", "", b) for b in bullets(section("Observations"))]
    applied_lines = [l.strip() for l in section("Applied") if l.strip()]
    applied = " ".join(applied_lines) if applied_lines else None
    return {"date": date, "proposals": proposals, "applied": applied,
            "observations": obs}


# ── ledger tail ──────────────────────────────────────────────────────────────

def tail_jsonl(path: Path, n: int) -> list[dict]:
    """The last `n` valid JSON objects from a JSONL file, newest-first, read
    from the end in blocks so an ever-growing append-only ledger costs O(tail)
    not O(file). Blank/malformed lines are skipped exactly as a full parse
    skips them, so the result equals `[full-parse][-n:][::-1]`. [] if unreadable."""
    if n <= 0:
        return []
    out: list[dict] = []
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            pos = f.tell()
            buf = b""
            while pos > 0 and len(out) < n:
                step = min(65536, pos)
                pos -= step
                f.seek(pos)
                buf = f.read(step) + buf
                # buf[0] may be a mid-line fragment (more bytes precede it), so
                # hold it back for the next earlier block; parse the rest, newest
                # (nearest EOF) first.
                parts = buf.split(b"\n")
                buf = parts[0]
                for raw in reversed(parts[1:]):
                    s = raw.strip()
                    if not s:
                        continue
                    try:
                        out.append(json.loads(s))
                    except (json.JSONDecodeError, ValueError):
                        continue
                    if len(out) >= n:
                        break
            if len(out) < n:  # reached BOF — the held-back fragment is line 1
                s = buf.strip()
                if s:
                    try:
                        out.append(json.loads(s))
                    except (json.JSONDecodeError, ValueError):
                        pass
    except OSError:
        return []
    return out[:n]


def build_ledger(loops: list[str] | None = None) -> list[dict]:
    # Folded into the actor taxonomy on the way out (docs/actor-taxonomy.md) —
    # `hub` and the hub persona are the same session, and every dispatched worker
    # reads as `ephemeral` with its slug in session_id.
    rows = tail_jsonl(STATE / "ledger.jsonl", LEDGER_TAIL)
    return [actors.normalize_row(r, loops) if isinstance(r, dict) else r
            for r in rows]


# ── Claude Code usage (local, token-free rolling-window aggregate) ────────────
# What `/usage` shows — the account-wide %-of-5h-limit — is server-side rate-limit
# state fetched live from Anthropic; it is NOT persisted anywhere locally. But the
# raw material IS: Claude Code writes one JSONL transcript per session under
# ~/.claude/projects/<slug>/, and every assistant line carries message.usage
# (input/output/cache tokens) + an ISO timestamp. Summing those over the last N
# hours is exactly what `ccusage` does — pure file reads + arithmetic, no model,
# no network. So we surface a LOCAL token estimate for the current window and are
# explicit that it is this-host-only and not the official %-of-limit.
#
# Cheap by construction: mtime pre-filters to the handful of files touched in the
# window, a substring test skips non-usage lines before any JSON parse, and the
# whole thing is wrapped so a failure degrades to a graceful "unavailable" — it
# can never break the token-free regen. Disable entirely with DASHBOARD_USAGE=0.
#
# Incremental accounting (the expensive part made cheap): the active transcripts
# are long-lived append-only JSONL, so re-reading each in-window file from byte
# zero every 45s reparsed hundreds of MiB of unchanged prefix. Instead we keep a
# per-file checkpoint (inode + byte offset + the parsed in-window usage records)
# in state/usage/transcript_cache.json and, on each pass, seek to the checkpoint
# and parse only the bytes appended since. Unchanged files cost one stat; the
# aggregation then runs over the same record set a full scan would have produced,
# so the numbers are byte-identical — only the I/O is avoided. The cache is a
# pure optimization: any inconsistency (rotation, truncation, corrupt cache)
# falls back to a full reparse of that file, never a wrong number.


def _transcript_base() -> Path:
    override = os.environ.get("DASHBOARD_TRANSCRIPT_BASE")
    return Path(override) if override else (Path.home() / ".claude" / "projects")


def _transcript_cache_path() -> Path:
    override = os.environ.get("DASHBOARD_TRANSCRIPT_CACHE")
    return Path(override) if override else (STATE / "usage" / "transcript_cache.json")


def _iter_usage_records(raw: bytes):
    """Yield one record per usage-bearing complete JSONL line in `raw`.
    Mirrors the original inline parse exactly (substring prefilter, timestamp +
    non-empty usage requirement); the caller applies the window cutoff so old
    lines can be cached and pruned without changing any total."""
    for line in raw.decode("utf-8", "ignore").splitlines():
        if '"usage"' not in line:
            continue
        try:
            d = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        ts = d.get("timestamp")
        if not ts:
            continue
        try:
            t = datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError):
            continue
        message = d.get("message") or {}
        u = message.get("usage") or {}
        if not u:
            continue
        # [t, usage, model, loop, sid] — compact list keeps the cache small.
        yield [t, u, message.get("model"),
               _cwd_to_loop(d.get("cwd")), d.get("sessionId") or d.get("session_id")]


def _write_cache(path: Path, data: dict) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(data), encoding="utf-8")
        tmp.replace(path)
    except OSError:
        pass  # cache is best-effort; a failed write just re-reads next pass


def _scan_records(cutoff_ts: float, byte_cap: int) -> list[list]:
    """Return all in-window usage records ([t, usage, model, loop, sid]) across
    the transcript tree, reading only bytes appended since the last pass. Applies
    the same mtime pre-filter as before (files last touched before the cutoff hold
    no in-window line) and refreshes the on-disk checkpoint cache."""
    base = _transcript_base()
    cache_path = _transcript_cache_path()
    cached = read_json(cache_path)
    files_cache = cached.get("files") if isinstance(cached, dict) else None
    if not isinstance(files_cache, dict):
        files_cache = {}

    records: list[list] = []
    new_cache: dict[str, dict] = {}
    read_bytes = 0
    for p in sorted(base.glob("*/*.jsonl")):
        try:
            stt = p.stat()
        except OSError:
            continue
        if stt.st_mtime < cutoff_ts:
            continue  # entirely out of window — and dropped from the cache
        key = str(p)
        prev = files_cache.get(key)
        # Reuse the checkpoint only when the file is the same inode and hasn't
        # shrunk below our offset (rotation/truncation → full reparse from 0).
        if (isinstance(prev, dict) and prev.get("inode") == stt.st_ino
                and isinstance(prev.get("offset"), int)
                and 0 <= prev["offset"] <= stt.st_size):
            offset = prev["offset"]
            lines = list(prev.get("lines") or [])
        else:
            offset, lines = 0, []

        if offset < stt.st_size and read_bytes < byte_cap:
            try:
                with p.open("rb") as f:
                    f.seek(offset)
                    chunk = f.read()
            except OSError:
                chunk = b""
            read_bytes += len(chunk)
            # Only consume through the last complete line; a partial trailing
            # line (mid-append) stays unconsumed so it is counted once, later.
            nl = chunk.rfind(b"\n")
            if nl >= 0:
                for rec in _iter_usage_records(chunk[:nl + 1]):
                    lines.append(rec)
                offset += nl + 1

        # Prune to the window for both the returned set and what we re-cache.
        kept = [ln for ln in lines if ln[0] >= cutoff_ts]
        records.extend(kept)
        new_cache[key] = {"inode": stt.st_ino, "size": stt.st_size,
                          "mtime": stt.st_mtime, "offset": offset, "lines": kept}
        if read_bytes >= byte_cap:
            break  # safety ceiling; steady-state appends never approach it

    _write_cache(cache_path, {"version": 1, "files": new_cache})
    return records


def build_usage(now: datetime, registry: dict) -> dict:
    cfg = (registry.get("dashboard") or {})
    if os.environ.get("DASHBOARD_USAGE", "1") == "0":
        return {"available": False, "reason": "disabled"}
    try:
        hours = float(cfg.get("usage_window_hours", 5) or 5)
    except (TypeError, ValueError):
        hours = 5.0
    budget = cfg.get("usage_soft_budget_output_tokens")
    try:
        budget = int(budget) if budget else None
    except (TypeError, ValueError):
        budget = None

    from datetime import timedelta
    cutoff = now - timedelta(hours=hours)
    cutoff_ts = cutoff.timestamp()
    BYTE_CAP = 400 * 1024 * 1024  # safety ceiling on bytes read per pass

    try:
        records = _scan_records(cutoff_ts, BYTE_CAP)
    except OSError:
        return {"available": False, "reason": "no local transcripts"}

    tok_in = tok_out = cc = cr = msgs = 0
    cost_total = 0.0
    sessions: set[str] = set()
    cost_by_loop: dict[str, dict] = defaultdict(lambda: {"tokens": 0, "cost_usd": 0.0})
    cost_by_session: dict[str, dict] = defaultdict(
        lambda: {"tokens": 0, "cost_usd": 0.0, "loop": "other"})
    # records are [t, usage, model, loop, sid], already in glob+append order and
    # window-filtered by _scan_records; the accumulation below is unchanged.
    for t, u, model, loop, sid in records:
        if t < cutoff_ts:
            continue
        msgs += 1
        if sid:
            sessions.add(sid)
        line_in = u.get("input_tokens", 0) or 0
        line_out = u.get("output_tokens", 0) or 0
        line_cc = u.get("cache_creation_input_tokens", 0) or 0
        line_cr = u.get("cache_read_input_tokens", 0) or 0
        tok_in += line_in
        tok_out += line_out
        cc += line_cc
        cr += line_cr
        line_cost = _line_cost_usd(model, u)
        cost_total += line_cost
        lb = cost_by_loop[loop]
        lb["tokens"] += line_in + line_out + line_cc + line_cr
        lb["cost_usd"] += line_cost
        if sid:
            sb = cost_by_session[sid]
            sb["tokens"] += line_in + line_out + line_cc + line_cr
            sb["cost_usd"] += line_cost
            sb["loop"] = loop

    total = tok_in + tok_out + cc + cr
    pct = None
    if budget and budget > 0:
        pct = round(tok_out / budget * 100)

    loop_rows = sorted(
        ({"loop": k, "tokens": v["tokens"], "cost_usd": round(v["cost_usd"], 4)}
         for k, v in cost_by_loop.items()),
        key=lambda r: r["cost_usd"], reverse=True)
    top_sessions = sorted(
        ({"session": sid[:8], "loop": v["loop"], "tokens": v["tokens"],
          "cost_usd": round(v["cost_usd"], 4)}
         for sid, v in cost_by_session.items()),
        key=lambda r: r["cost_usd"], reverse=True)[:8]

    return {
        "available": msgs > 0,
        "window_hours": hours, "input": tok_in, "output": tok_out,
        "cache_creation": cc, "cache_read": cr, "total": total,
        "messages": msgs, "sessions": len(sessions),
        "budget_output": budget, "pct_of_budget": pct,
        "cost_usd": round(cost_total, 4),
        "cost_by_loop": loop_rows,
        "top_sessions": top_sessions,
        "note": "local Claude Code usage on this host — approximate, "
                "not the account-wide %-of-limit /usage shows",
        "pricing_note": "cost is a list-price estimate (published per-model "
                        "input/output rates + standard cache-write/read "
                        "multipliers) — not exact billing",
    }


# ── account usage cap (state/usage/budget.json, populated by bin/usage-fetch) ─
# This is the SAME signal review.py's budget guard gates on (see BUDGET in
# loops/pr-reviewer/.claude/skills/pr-reviewer/scripts/review.py) — real
# account-wide %-of-limit when bin/usage-fetch's authenticated call works,
# a local-estimate proxy otherwise. None if usage-fetch hasn't run yet.

def build_cap_signal() -> dict | None:
    return read_json(STATE / "usage" / "budget.json")

def build_estate_activity(registry: dict | None = None) -> dict:
    # Loop names from the live registry, so a loop added to loops.toml is
    # classified as a loop without editing lib/actors.py.
    loop_names = sorted((registry or {}).get("loops", {}))
    out = {"available": False, "tasks": [], "task_counts": {}, "kind_counts": {}, "stage_counts": {}, "events": [], "task_events": {}, "project_events": {}, "projects": [], "project_counts": {}, "dependencies": [], "dep_counts": {}, "attention": [], "attention_counts": {}, "followups": [], "followup_counts": {}, "proposals": [], "proposal_counts": {}, "inbox_messages": [], "inbox_message_counts": {}, "extractions": {"available": False, "items": [], "counts": {}}, "memories": {"available": False, "items": [], "counts": {}, "phase": "M0 not initialized"}}
    db = STATE / "estate.db"
    if db.exists():
        try:
            conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
            conn.row_factory = sqlite3.Row
            # ONE composed read for tasks, projects, edges, attention and
            # decoded follow-ups (t-135, lib/estate_work.py). Every field it
            # adds is derived on this read and none is stored: `blocked_by`
            # keeps a blocked task at status='ready' because being blocked is a
            # fact about its neighbours (P-18), `due_state` moves with the
            # clock and not with any row (P-07), and a project rollup is
            # counted from the task rows rather than kept in a column that has
            # to be re-written every time a task moves.
            work = estate_work.build(conn)
            out["tasks"] = work["tasks"]
            for key in ("projects", "project_counts", "dependencies",
                        "dep_counts", "attention", "attention_counts",
                        "followups", "followup_counts", "proposals",
                        "proposal_counts", "inbox_messages",
                        "inbox_message_counts"):
                out[key] = work[key]
            out["notice_days"] = work["notice_days"]
            out["events"] = [actors.normalize_row(dict(r), loop_names) for r in conn.execute("SELECT * FROM events ORDER BY seq DESC LIMIT 80")]
            # Drill-down runs off the AUTHORITATIVE table, not the 80-row slice
            # above (P-16). The panel's recent-activity list is a tail by
            # design; a task's own history is not, and reading it out of that
            # tail silently emptied the drill-down of every task whose events
            # had scrolled off. Same query surface `estate events` uses, so the
            # CLI and the page can never answer this differently. One indexed
            # lookup per task (idx_events_task).
            try:
                out["task_events"] = {
                    task["id"]: [actors.normalize_row(dict(r), loop_names)
                                 for r in estate_events.select(conn, {"task": task["id"]})]
                    for task in out["tasks"]}
            except estate_events.MissingColumn:
                # A store too old to link events to tasks has no drill-down to
                # show. Same rule as blocked_by: a derived view must never take
                # down the panel that carries it.
                out["task_events"] = {}
            # A project's OWN history, from the same authoritative table
            # (§4.9 of t-124's report) — and ONLY the rows no task already
            # carries. An event written against a project's task names both
            # ids, so an unfiltered `--project p-1` read would ship every one
            # of those rows a second time; on the live store that was 55kB of
            # exact duplicate. The page composes the project's own rows with
            # its tasks' histories client-side, where the join is free (§4.10 —
            # this snapshot is append-only and already grows on its own).
            try:
                out["project_events"] = {
                    project["id"]: [actors.normalize_row(dict(r), loop_names)
                                    for r in estate_events.select(conn, {"project": project["id"]})
                                    if not r["task_id"]]
                    for project in out["projects"] if not project.get("unprojected")}
            except estate_events.MissingColumn:
                out["project_events"] = {}
            out["task_counts"] = {r["status"]: r["n"] for r in conn.execute("SELECT status, count(*) n FROM tasks GROUP BY status")}
            out["kind_counts"] = {r["kind"]: r["n"] for r in conn.execute("SELECT kind, count(*) n FROM tasks GROUP BY kind")}
            # P-02: the retained review state, counted by stage. Separate from
            # task_counts on purpose — a proposal's review decision and its
            # work status are different facts, and one grid showing both would
            # imply they are alternatives. A store without the column predates
            # the lifecycle and simply has no stages to count — same rule as
            # blocked_by, a derived view never takes down the panel.
            try:
                out["stage_counts"] = {r["stage"]: r["n"] for r in conn.execute(
                    "SELECT stage, count(*) n FROM tasks WHERE stage IS NOT NULL GROUP BY stage")}
            except sqlite3.OperationalError:
                out["stage_counts"] = {}
            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if "memories" in tables:
                memories = [dict(r) for r in conn.execute("SELECT * FROM memories ORDER BY updated_at DESC")]
                memory_counts = defaultdict(int)
                for memory in memories: memory_counts[memory.get("status", "candidate")] += 1
                out["memories"] = {"available": True, "items": memories, "counts": dict(memory_counts), "phase": "shared memory store active"}
            out["available"] = True
            conn.close()
        except sqlite3.Error as exc: out["error"] = str(exc)
    store = read_json(STATE / "extraction" / "candidates.json")
    if isinstance(store, dict) and isinstance(store.get("items"), dict):
        items = sorted(store["items"].values(), key=lambda i: i.get("updated_at", ""), reverse=True)
        counts = defaultdict(int)
        for item in items: counts[item.get("status", "candidate")] += 1
        out["extractions"] = {"available": True, "items": items, "counts": dict(counts), "updated_at": store.get("updated_at")}
    ledger_rows = []
    raw_ledger = read_text(STATE / "ledger.jsonl")
    if raw_ledger is not None:
        for line in raw_ledger.splitlines():
            try: row = json.loads(line)
            except json.JSONDecodeError: continue
            if isinstance(row, dict): ledger_rows.append(actors.normalize_row(row, loop_names))
    # Counted on the canonical actor, so the operator is ONE total rather than a
    # `hub` total and a hub-persona total, and the ephemeral tail collapses into
    # a single chip instead of ~20 one-row chips. by_class is the coarse read;
    # by_session traces which dispatches wrote the ephemeral rows.
    by_actor, by_kind, by_class = defaultdict(int), defaultdict(int), defaultdict(int)
    by_session = defaultdict(int)
    for row in ledger_rows:
        by_actor[row["actor"]] += 1
        by_class[row["actor_class"]] += 1
        by_kind[str(row.get("kind") or "unknown")] += 1
        if row["session_id"]: by_session[row["session_id"]] += 1
    out["ledger_health"] = {"available": raw_ledger is not None, "count": len(ledger_rows), "by_actor": dict(by_actor), "by_class": dict(by_class), "by_session": dict(by_session), "by_kind": dict(by_kind), "recent": list(reversed(ledger_rows[-50:]))}
    lessons = read_text(ROOT / "docs" / "lessons.md")
    out["memories"]["manual_lessons"] = sum(1 for line in (lessons or "").splitlines() if line.startswith("- **"))
    out["memories"]["curator_configured"] = (ROOT / "loops" / "curator").exists()
    private = []
    scopes = [("hub", ROOT)]
    for name, cfg in (registry or {}).get("loops", {}).items():
        scopes.append((name, ROOT / cfg.get("dir", f"loops/{name}")))
    for name, cwd in scopes:
        encoded = str(cwd.resolve()).replace("/", "-")
        path = Path.home() / ".claude" / "projects" / encoded / "memory" / "MEMORY.md"
        body = read_text(path)
        private.append({"scope": name, "available": body is not None,
                        "body": body or "", "path": str(path),
                        "bytes": len((body or "").encode("utf-8"))})
    out["memories"]["private"] = private
    return out


# ── assemble snapshot ────────────────────────────────────────────────────────

def build_snapshot() -> dict:
    now_dt = datetime.now(timezone.utc)
    now = now_dt.timestamp()
    # Fail loudly on an unreadable registry. `or ""` used to make this parse to
    # an empty dict, so the dashboard rendered a healthy-looking page with zero
    # loops — the same "green but sees no data" shape as the ab77cc8 state-dir
    # bug. dashboard-refresh logs the non-zero exit instead.
    raw = read_text(ROOT / "loops.toml")
    if raw is None:
        sys.exit(f"dashboard: cannot read {ROOT / 'loops.toml'}")
    registry = tomllib.loads(raw)
    dashboard_config = registry.get("dashboard", {})
    # One agent-deck read for the whole snapshot — the per-loop status sweep and
    # the ephemeral list both index into it (was one `session show` per loop plus
    # a separate `ls --json`).
    deck = deck_ls()
    loops = build_loops(registry, now, deck_index(deck))
    pr_board = build_pr_board()
    night = build_night()
    focus = build_focus()
    mechanic = build_mechanic()
    ephemeral = build_ephemeral(now_dt, deck)
    usage = build_usage(now_dt, registry)
    usage["cap"] = build_cap_signal()

    live = sum(1 for l in loops if l["session_present"]
               and (l["autostart"] or l["is_hub"]))
    ondemand = sum(1 for l in loops if not l["autostart"] and not l["is_hub"])
    queued = sum(1 for i in night["queue"] if i["status"] == "queued")
    needs_you_q = sum(1 for i in night["queue"] if i["status"] == "needs-you")

    return {
        "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "generated_epoch": int(now),
        "host": socket.gethostname(),
        # Header identity, in the order an install is most likely to have set
        # it: the dashboard's own labels, else the [hub] identity every other
        # component already reads, else the neutral default.
        "estate": dashboard_config.get("estate_name") or ESTATE,
        "operator": dashboard_config.get("operator_name") or HUB_PERSONA,
        "loops": loops,
        "ephemeral": ephemeral,
        "usage": usage,
        "pr_board": pr_board,
        "night": night,
        "focus": focus,
        "brief": build_brief(),
        "mechanic": mechanic,
        "ledger": build_ledger(sorted(registry.get("loops", {}))),
        "estate_activity": build_estate_activity(registry),
        "vitals": {
            "loops_live": live,
            "loops_ondemand": ondemand,
            "needs_you": pr_board["buckets"]["waiting_you"],
            "going_astray": pr_board["buckets"]["going_astray"],
            "queue_queued": queued,
            "queue_needs_you": needs_you_q,
            "proposals": len(mechanic["proposals"]),
        },
    }


