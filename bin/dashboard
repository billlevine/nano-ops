#!/usr/bin/env python3
"""estate dashboard — Tier-1 local live-update renderer.

PURE READER. Aggregates real on-disk loop state + live agent-deck session
status into one data model, then emits it as JSON plus the HTML that renders
it. It NEVER writes to any loop's state — its only outputs (all under state/):

    state/dashboard.json       the aggregated data model + pre-rendered section
                               HTML (single source of truth; polled by the shell)
    state/index.html           the Tier-1 LIVE SHELL, generated separately by
                               bin/dashboard-index; its only network call
                               is same-origin dashboard.json
    state/dashboard.body.html  data-inlined body fragment for the Artifact tool
                               (static snapshot; no fetch)

Modes:
    bin/dashboard          (re)write json + static Artifact fragment
    bin/dashboard --json   write state/dashboard.json ONLY — deterministic and
                           token-free; this is what the local regenerator runs

Serve it (Tier-1):  flox activate --start-services   (`bin/ops dashboard`
    prints the URL) -> http://<host>:<port>/   (host/port in loops.toml [dashboard];
       default 127.0.0.1:8422 — see that file for what the configured host exposes)

Reads:
    loops.toml                          loop registry (persona/interval/model)
    state/estate.db                     shared tasks/events/memories (read-only)
    state/extraction/candidates.json    extraction lifecycle
    docs/lessons.md                     rendered lesson count
    ~/.claude/projects/<cwd>/memory/MEMORY.md
                                        private Claude memory for the hub and
                                        each configured loop directory
    state/usage/budget.json             account usage-cap signal
    state/<loop>/last_tick              heartbeat epoch -> freshness
    state/hub/doorbell_alive            doorbell poll-liveness epoch (separate
                                        from last_tick — proves the wake-on-
                                        activity poller is up even when the
                                        hub itself has been idle a while)
    agent-deck ls --json                ONE read serving both live per-loop status
                                        (running/idle/waiting) + model, and the hub
                                        ephemeral sessions in flight NOW
                                        (loops.toml [hub].group, title
                                        "ephemeral - …")
    ~/.claude/projects/*/*.jsonl        local Claude Code token usage, current
                                        rolling window (read-only, token-free;
                                        approximate — this host only, NOT the
                                        account-wide %-of-limit /usage reports)
    state/pr-tracker/state.json         PR board buckets (the tracker's own
                                        `derived` classification — never re-derived)
    state/dashboard-acks.json           per-PR "seen" marks (written only by
                                        dashboard-server when the operator
                                        clicks a ✳)
    state/pr-tracker/DASHBOARD.md       board metadata (scanned repos, updated)
    state/pr-reviewer/queue.json        night-shift queue
    state/pr-reviewer/NIGHT-REPORT.md   last night's outcome
    state/morning-brief/reports/*.md    latest daily digest (placeholder if none)
    state/morning-brief/publications.json
                                        per-date generation/delivery record —
                                        did that digest actually reach Slack
                                        (P-10; the report file is unchanged)
    state/morning-brief/manifests/*.json
                                        per-date SOURCE manifest — what each of
                                        the briefer's nine gatherers could
                                        actually see (P-11). The Daily Digest
                                        panel's source strip is rendered FROM
                                        this, never re-derived from raw producer
                                        state, so the panel and the summary
                                        cannot disagree about what happened
    state/mechanic/REPORT.md            pending self-optimization proposals
    state/ledger.jsonl                  recent estate activity (tail)
"""

from __future__ import annotations

import base64
import glob
