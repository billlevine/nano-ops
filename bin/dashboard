# P-11. The freshness half of every source chip, re-derived in the browser from
# the two numbers the MANIFEST carries — `as_of` (when that source's data was
# true) and `max_age_seconds` (its budget). Nothing here reads producer state or
# invents a threshold: the page ticks the clock, the brief owns the policy. Both
# the live shell and the static Artifact fragment run it, so a page left open
# all day tells the truth without a regeneration.
SOURCE_JS = r"""
(function(){
  function human(s){s=Math.max(0,Math.floor(s));
    return s<90?s+'s':s<5400?Math.round(s/60)+'m':s<172800?Math.round(s/3600)+'h':Math.round(s/86400)+'d';}
  function tick(){
    var chips=document.querySelectorAll('.srcchip[data-asof]');
    for(var i=0;i<chips.length;i++){
      var c=chips[i], asof=c.getAttribute('data-asof');
      var max=parseFloat(c.getAttribute('data-maxage'))||0;
      var age=asof?(Date.now()-Date.parse(asof))/1000:NaN;
      var out=c.querySelector('.srcage');
      if(!isFinite(age)){c.classList.remove('f-current','f-stale');
        c.classList.add('f-unknown');if(out)out.textContent='—';continue;}
      if(age<0)age=0;
      if(out)out.textContent=human(age);
      c.classList.remove('f-unknown');
      c.classList.toggle('f-stale',age>max);
      c.classList.toggle('f-current',age<=max);
    }
  }
  tick();setInterval(tick,15000);
  window.OPS_TICK_SOURCES=tick;
})();
"""

JS = r"""
(function(){
  var root=document.documentElement;
  var KEY='ops-dash-theme';
  function apply(t){root.setAttribute('data-theme',t);
    var b=document.getElementById('themebtn');
    if(b)b.textContent=(t==='dark'?'☀ Day shift':'☾ Night shift');}
  var saved=null;try{saved=localStorage.getItem(KEY);}catch(e){}
  if(saved)apply(saved);
  else{var d=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
    apply(d?'dark':'light');}
  var btn=document.getElementById('themebtn');
  if(btn)btn.addEventListener('click',function(){
    var cur=root.getAttribute('data-theme')||'dark';
    var next=cur==='dark'?'light':'dark';apply(next);
    try{localStorage.setItem(KEY,next);}catch(e){}});
  // relative "generated" age
  var el=document.getElementById('gen-rel');
  if(el){var ep=parseInt(el.getAttribute('data-epoch'),10);
    function rel(){var s=Math.max(0,Math.floor(Date.now()/1000)-ep);
      var o=s<90?s+'s':s<5400?Math.round(s/60)+'m':s<172800?Math.round(s/3600)+'h':Math.round(s/86400)+'d';
      el.textContent=o+' ago';}
    rel();setInterval(rel,15000);}
})();
"""

# Client script for the Tier-1 LIVE SHELL (state/dashboard.html). Fetches the
# same-origin dashboard.json every ~30s and swaps each section into the DOM in
# place — only when that section's HTML changed, so unchanged panels keep their
# scroll. The section/vitals HTML in the JSON is produced by the SAME render_*
# functions used for the Artifact fragment, so the live view and the fragment
# never diverge. Theme + rel-clock tick client-side; a footer pill shows
# live / stale (regenerator lagging) / offline (fetch failing).
SHELL_JS = r"""
(function(){
  var root=document.documentElement, KEY='ops-dash-theme';
  function applyTheme(t){root.setAttribute('data-theme',t);
    var b=document.getElementById('themebtn');
    if(b)b.textContent=(t==='dark'?'☀ Day shift':'☾ Night shift');}
  var saved=null;try{saved=localStorage.getItem(KEY);}catch(e){}
  if(saved)applyTheme(saved);
  else{var d=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
    applyTheme(d?'dark':'light');}
  var tb=document.getElementById('themebtn');
  if(tb)tb.addEventListener('click',function(){
    var cur=root.getAttribute('data-theme')||'dark',next=cur==='dark'?'light':'dark';
    applyTheme(next);try{localStorage.setItem(KEY,next);}catch(e){}});

  var SEC=window.OPS_DASH_SECTIONS||{loops:'sec-loops',ephemeral:'sec-ephemeral',night:'sec-night',
           focus:'sec-focus',pr_board:'sec-pr',mechanic:'sec-mech',
           brief:'sec-brief',ledger:'sec-ledger'};
  var cache={}, genEpoch=0, lastOk=0, everOk=false;

  function human(s){s=Math.max(0,Math.floor(s));
    return s<90?s+'s':s<5400?Math.round(s/60)+'m':s<172800?Math.round(s/3600)+'h':Math.round(s/86400)+'d';}
  function setText(id,t){var el=document.getElementById(id);if(el)el.textContent=t;}
  function put(id,h){if(h==null||cache[id]===h)return;
    var el=document.getElementById(id);if(!el)return;el.innerHTML=h;cache[id]=h;}

  function apply(d){
    genEpoch=d.generated_epoch||0;
    setText('gen-abs',(d.generated_at||'').replace('+00:00','Z'));
    setText('gen-host',d.host||'—');
    put('vitals',d.vitals_html);
    put('usage',d.usage_html);
    var secs=d.sections||{};
    for(var k in SEC){put(SEC[k],secs[k]);}
    setText('mech-date',(d.mechanic&&d.mechanic.date)||'—');
    setText('eph-count',String((d.ephemeral||[]).length));
    setText('led-count',String((d.ledger||[]).length));
    /* The brief section may have just been swapped in with server-rendered
       freshness classes as of the LAST regeneration — re-tick them from the
       manifest's own as_of/max-age so the chips are right immediately. */
    if(window.OPS_TICK_SOURCES)window.OPS_TICK_SOURCES();
    document.dispatchEvent(new CustomEvent('ops-dashboard-data',{detail:d}));
  }

  function tick(){
    var age=genEpoch?Math.floor(Date.now()/1000)-genEpoch:null;
    setText('gen-rel',age==null?'…':human(age)+' ago');
    var pill=document.getElementById('livestat');if(!pill)return;
    var sinceOk=everOk?(Date.now()-lastOk)/1000:Infinity, cls='live', label='live';
    if(!everOk||sinceOk>150){cls='offline';label='offline — retrying';}
    else if((age!=null&&age>120)||sinceOk>75){cls='stale';label='stale — regenerator lagging';}
    pill.className='stat '+cls;
    setText('livestat-label',label);
  }

  function refresh(){
    fetch('dashboard.json?t='+Math.floor(Date.now()/1000),{cache:'no-store'})
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(function(d){lastOk=Date.now();everOk=true;apply(d);tick();})
      .catch(function(){tick();});
  }
  refresh();setInterval(refresh,30000);setInterval(tick,1000);
})();
"""

# PR-board "new activity" marks for the LIVE SHELL. The section HTML in
# dashboard.json already carries a per-row activity signature and the tracker's
# rendered guess at unseen-ness, but that JSON is up to ~45s stale — so the
# client treats acks.json (served straight off disk, always current) as the
# authority and re-derives unseen = acked[id] !== sig after every section swap.
# That ordering is what stops a just-acknowledged row from re-lighting on the
# next poll. Acks POST to /ack and persist server-side, so they survive reload,
# server restart, and regeneration. Not included in the static Artifact
# fragment, which has no server to talk to.
ACK_JS = r"""
(function(){
  var acked={}, loaded=false, inflight=false;
  /* Write endpoints may be token-protected (state/secrets/dashboard-write-token
     on the server). The token is prompted once on the first write, cached in
     localStorage, and attached to every /ack POST. A 401 (rotation / "log out")
     clears the cached value and re-prompts cleanly, so a stale token can't wedge
     the board. Reads never carry it. If the server has no token file, it ignores
     the header and every write just succeeds — back-compat with no prompt hassle
     beyond that first, cancellable ask. */
  var TOKEN_KEY='ops-dashboard-write-token';
  function token(){
    var t=null;try{t=localStorage.getItem(TOKEN_KEY);}catch(e){}
    if(t===null){
      try{t=window.prompt('Dashboard write token (leave blank if the server has none):');}catch(e){t=null;}
      if(t===null)t='';   /* treat cancel as "no token" so a click isn't re-prompted forever */
      try{localStorage.setItem(TOKEN_KEY,t);}catch(e){}
    }
    return t;
  }
  function clearToken(){try{localStorage.removeItem(TOKEN_KEY);}catch(e){}}
  function send(items){
    var headers={'Content-Type':'application/json'};
    var tok=token();if(tok)headers['X-Dashboard-Token']=tok;
    return fetch('ack',{method:'POST',cache:'no-store',
      headers:headers,body:JSON.stringify({ids:items})});
  }
  function rows(){return document.querySelectorAll('[data-ack-sig]');}
  function unseenOf(row){
    var id=row.getAttribute('data-ack-id'), sig=row.getAttribute('data-ack-sig');
    return loaded?acked[id]!==sig:row.getAttribute('data-unseen')==='1';
  }
  function apply(){
    var n=0;
    Array.prototype.forEach.call(rows(),function(row){
      var u=unseenOf(row);row.classList.toggle('unseen',u);if(u)n++;});
    Array.prototype.forEach.call(document.querySelectorAll('.ackbar'),function(bar){
      var el=bar.querySelector('.ackn-n');if(el)el.textContent=String(n);
      if(n)bar.removeAttribute('hidden');else bar.setAttribute('hidden','');});
  }
  /* acks.json stores {id:{sig,at}}; flatten to {id:sig} — the `at` is only
     there so the server can expire marks for PRs that left the board. */
  function take(d){
    var src=(d&&d.acks)||{};acked={};
    for(var k in src)if(src[k])acked[k]=src[k].sig;
    loaded=true;apply();
  }
  function pull(){
    fetch('acks.json?t='+Math.floor(Date.now()/1000),{cache:'no-store'})
      .then(function(r){if(!r.ok)throw 0;return r.json();}).then(take).catch(function(){});
  }
  function push(items){
    if(!items.length||inflight)return;
    inflight=true;
    items.forEach(function(it){acked[it.id]=it.sig;});loaded=true;apply();
    send(items)
      .then(function(r){
        if(r.status===401){clearToken();return send(items);}  /* rotation/logout: re-prompt once */
        return r;
      })
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(take).catch(pull).then(function(){inflight=false;});
  }
  function one(row){
    var id=row.getAttribute('data-ack-id'), sig=row.getAttribute('data-ack-sig');
    if(id&&sig)push([{id:id,sig:sig}]);
  }
  function all(){
    var items=[];
    Array.prototype.forEach.call(rows(),function(row){
      if(!unseenOf(row))return;
      var id=row.getAttribute('data-ack-id'), sig=row.getAttribute('data-ack-sig');
      if(id&&sig)items.push({id:id,sig:sig});});
    push(items);
  }
  /* Capture phase, not bubble: the mark sits inside the row's own <a href>,
     and this must win the race against the link's default navigation, which
     the browser can otherwise commit to before a bubble-phase listener runs. */
  document.addEventListener('click',function(e){
    var mark=e.target.closest&&e.target.closest('.ack');
    if(mark){e.preventDefault();e.stopPropagation();  /* row is a link to the PR */
      var row=mark.closest('[data-ack-sig]');if(row)one(row);return;}
    if(e.target.closest&&e.target.closest('.ackall')){e.preventDefault();all();}
  },true);
  document.addEventListener('keydown',function(e){
    if(e.key!=='Enter'&&e.key!==' ')return;
    var mark=e.target.closest&&e.target.closest('.ack');if(!mark)return;
    e.preventDefault();e.stopPropagation();
    var row=mark.closest('[data-ack-sig]');if(row)one(row);
  });
  /* Re-derive marks whenever the shell swaps in a fresh PR section. apply()
     itself writes .ackn-n's textContent — a childList mutation *inside* the
     observed subtree — so it must run with the observer disconnected, or each
     apply() would re-trigger the observer and spin the main thread forever. */
  var host=document.getElementById('sec-pr'), obs=null;
  function reapply(){if(obs)obs.disconnect();apply();if(obs&&host)obs.observe(host,{childList:true,subtree:true});}
  if(host){obs=new MutationObserver(reapply);obs.observe(host,{childList:true,subtree:true});}
  apply();pull();setInterval(pull,30000);
})();
"""


def status_class(loop: dict) -> tuple[str, str]:
    if not loop["session_present"]:
        if not loop["autostart"] and not loop["is_hub"]:
            return "na", "on-demand"
        return "down", "stopped"
    st = (loop["session_status"] or "").lower()
    if st == "running":
        return "run beat", "running"
    if st == "waiting":
        return "wait", "waiting"
    if st == "idle":
        return "idle", "idle"
    return "run", st or "up"


def render_loops(loops: list[dict]) -> str:
    rows = []
    for l in loops:
        lamp, label = status_class(l)
        hb = l["freshness"]
        hb_txt = human_age(l["heartbeat_age"]) if l["heartbeat_age"] is not None else "—"
        model_chip = (f'<span class="chip op">{E(l["model_pretty"])}</span>'
                      if l["is_hub"] else
                      f'<span class="chip model">{E(l["model_pretty"])}</span>')
        if l["is_hub"]:
            db_age = l.get("doorbell_age")
            db_txt = human_age(db_age) if db_age is not None else "—"
            db_cls = "fresh" if l.get("doorbell_alive") else "aging"
            hb_html = (
                f'<span class="hb {db_cls}" title="doorbell poll liveness — proves the '
                f'wake-on-activity poller is up independent of hub tick cadence">'
                f'<span class="dot"></span>doorbell {E(db_txt)}</span>'
                f'<span class="hb {hb}" title="last hub tick (work cadence)">'
                f'<span class="dot"></span>tick {E(hb_txt)}</span>'
            )
        else:
            hb_html = (f'<span class="hb {hb}" title="last heartbeat">'
                       f'<span class="dot"></span>{E(hb_txt)}</span>')
        rows.append(f'''
      <div class="loop">
        <span class="lamp {lamp}" title="{E(label)}"></span>
        <div class="who">
          <div class="persona">{E(l["persona"])}</div>
          <div class="role"><span class="lname">{E(l["name"])}</span> · {E(l["role"])}</div>
        </div>
        <div class="meta">
          {model_chip}
          <span class="chip">{E(l["interval"])}</span>
          {hb_html}
        </div>
      </div>''')
    return "".join(rows)


def render_note(note: str | None, inline: bool = False) -> str:
    """The operator's manual last-action note, date emphasized. inline=under-row list."""
    if not note:
        return ""
    d, body = split_note(note)
    dspan = f'<span class="pn-date">{E(d)}</span> ' if d else ""
    cls = "pno-note" if inline else "prnote"
    return f'<div class="{cls}">{dspan}{E(body)}</div>'


def render_ack(r: dict) -> tuple[str, str]:
    """(extra row attributes, the ✳ mark) for one PR row.

    The mark IS the click target — click it to acknowledge that row's current
    activity signature. It stays in the DOM when acknowledged (hidden, not
    removed) so nothing reflows as rows are cleared.
    """
    if not r.get("sig"):
        return "", ""
    when = r.get("activity_at") or ""
    title = f"new activity{f' · {when}' if when else ''} — click to mark seen"
    attrs = (f' data-ack-id="{E(str(r["id"]))}" data-ack-sig="{E(r["sig"])}"'
             + (' data-unseen="1"' if r.get("unseen") else ""))
    mark = (f'<span class="ack" role="button" tabindex="0" title="{E(title)}"'
            f' aria-label="Mark this PR seen">✳</span>')
    return attrs, mark


def render_held(r: dict) -> tuple[str, str]:
    """(the row's freshness tooltip, the `held` tag for an unobserved row).

    The tooltip is on every row: `last_successful_observation_at` is only
    useful if it is there when nothing is wrong too, which is the point P-03
    makes about exposing it on ordinary rows.
    """
    stamp = r.get("last_successful_observation_at") or ""
    when = str(stamp)[:16].replace("T", " ")
    if not r.get("unobserved"):
        return (f' title="last observed {E(when)} UTC"' if when else ""), ""
    srcs = ", ".join(r.get("unobserved_sources") or []) or "no source"
    title = (f"held — the spotter could not re-read this item "
             f"({r.get('unobserved_outcome')}: {srcs}). "
             + (f"Shown as of {when} UTC."
                if when else "It has no recorded observation time."))
    return f' title="{E(title)}"', '<span class="tag held">held</span>'


def render_pr_board(board: dict) -> str:
    b = board["buckets"]
    meta = board["meta"]
    tiles = [
        ("crit", b["going_astray"], "Going astray"),
        ("act", b["waiting_you"], "Waiting on you"),
        ("info", b["my_review"], "Your review"),
        ("calm", b["on_reviewers"], "On reviewers"),
        ("calm", b["in_progress"], "In progress"),
    ]
    tile_html = "".join(
        f'<div class="tile {c}"><div class="n">{n}</div><div class="l">{E(lbl)}</div></div>'
        for c, n, lbl in tiles)

    rows = []
    shown = board["act_first"][:ACTFIRST_CAP]
    for r in shown:
        cls = "astray" if r["astray"] else "mine"
        if r.get("unseen"):
            cls += " unseen"
        ack_attrs, ack_mark = render_ack(r)
        key = r["key"] or (r["linear_id"] or r["id"])
        idle = r["idle_days"]
        idle_cls = "hot" if (idle or 0) >= 7 else "warm" if (idle or 0) >= 4 else ""
        idle_txt = f'{idle:.1f}d idle' if idle is not None else ""
        flag_tags = "".join(
            f'<span class="tag {E(f)}">{E(f)}</span>'
            for f in r["flags"] if f != "astray")
        astray_tag = '<span class="tag astray">astray</span>' if r["astray"] else ""
        held_attr, held_tag = render_held(r)
        comments = (f'<span>💬 {r["comments"]}</span>'
                    if r.get("comments") else "")
        proj = (f'<span>{E(r["project"])}</span>' if r.get("project") else "")
        href = f' href="{E(r["url"])}"' if r["url"] else ""
        target = ' target="_blank" rel="noopener"' if r["url"] else ""
        rows.append(f'''
      <a class="prrow {cls}"{href}{target}{ack_attrs}{held_attr}>
        <div class="r1">
          {ack_mark}<span class="prkey">{E(str(key))}</span>
          <span class="prttl">{E(r["title"])}</span>
        </div>
        <div class="r2">
          {held_tag}{astray_tag}{flag_tags}
          <span class="idle-d {idle_cls}">{E(idle_txt)}</span>
          {comments}{proj}
        </div>
        {render_note(r.get("note"))}
      </a>''')
    more = len(board["act_first"]) - len(shown)
    if more > 0:
        rows.append(f'<div style="padding:10px;font-size:11px;color:var(--faint)">'
                    f'+{more} more in your court</div>')

    # noted PRs that have no act-first row — surface last action per PR anyway
    other = board.get("notes_other") or []
    other_html = ""
    if other:
        lines = []
        for r in other:
            key = r["key"] or (r["linear_id"] or r["id"])
            href = f' href="{E(r["url"])}"' if r["url"] else ""
            target = ' target="_blank" rel="noopener"' if r["url"] else ""
            ack_attrs, ack_mark = render_ack(r)
            cls = "pno unseen" if r.get("unseen") else "pno"
            work_tag = ('<span class="tag working">working</span>'
                        if r.get("in_progress") else "")
            held_attr, held_tag = render_held(r)
            lines.append(f'''
      <a class="{cls}"{href}{target}{ack_attrs}{held_attr}>
        <div class="r1">
          {ack_mark}<span class="prkey">{E(str(key))}</span>
          <span class="prttl">{E(r["title"])}</span>{work_tag}{held_tag}
        </div>
        {render_note(r.get("note"), inline=True)}
      </a>''')
        other_html = (f'<div class="pno-wrap"><div class="pno-head">last action · '
                      f'other tracked PRs</div>{"".join(lines)}</div>')

    scan = meta.get("scanning") or ""
    upd = meta.get("updated") or ""
    sub = (f'{meta.get("active")} active · {meta.get("ignored")} ignored'
           if meta.get("active") is not None else "")
    if board.get("snoozed"):
        sub += f'{" · " if sub else ""}{board["snoozed"]} snoozed'
    # Rendered unseen count; the live shell recomputes it from acks.json.
    unseen = sum(1 for r in shown + other if r.get("unseen"))
    ackbar = (f'<div class="ackbar"{"" if unseen else " hidden"}>'
              f'<span class="ackn">✳ <b class="ackn-n">{unseen}</b> with new activity</span>'
              f'<button class="ackall" type="button">mark all seen</button></div>')
    # P-03. Counts are computed over the whole board, so this fires even when
    # every held item sits in a bucket that never renders a row — the tiles
    # above are what would otherwise be quietly wrong.
    heldbar = ""
    n_held = board.get("unobserved") or 0
    if n_held:
        srcs = ", ".join(
            f'{s.get("source")} ({s.get("outcome")})'
            for s in (board.get("unreadable_sources") or []))
        heldbar = (f'<div class="heldbar">⏸ <b>{n_held}</b> tracked item(s) '
                   f'held — the spotter could not re-read them this refresh'
                   + (f' (could not read {E(srcs)})' if srcs else "")
                   + '. Their rows are the last real observation, not live '
                     'state. Nothing was archived on a failed fetch.</div>')
    return f'''
    <div class="tiles">{tile_html}</div>
    <div style="font-size:10.5px;color:var(--faint);margin:2px 2px 8px">
      {E(sub)}{" · scanning " + E(scan) if scan else ""}</div>
    {heldbar}{ackbar}
    {"".join(rows)}{other_html}'''


def _focus_issue_lis(ids: list, titles: dict) -> str:
    """Render each needs-you / then issue id as an <li> inside a .obs list —
    id plus its title where focus.json's `gaps` carries one, otherwise the
    bare id. (focus.json persists only ids + gap-flag titles today, not the
    morning-brief's fuller close-out narrative — see render_focus note.)"""
    lis = []
    for i in ids:
        lab = f'<span style="color:var(--dim)">{E(i)}</span>'
        t = titles.get(i)
        lis.append(f'<li>{lab} {E(t)}</li>' if t else f'<li>{lab}</li>')
    return "".join(lis)


def _focus_check_li(text: str) -> str:
    """One checklist line → an <li>. The `- [ ] ` marker is stripped (the
    `.obs li::before` supplies the "·" bullet), and the narrative runs through
    render_brief_markdown for escape-first-then-allow-list safety — the same
    markdown→HTML path the brief body uses (no bold/links appear in checklist
    lines today, so it's effectively an escape, but reuse keeps one path)."""
    return f"<li>{render_brief_markdown(text)}</li>"


def _focus_checklists(focus: dict) -> list[str] | None:
    """Rich per-project checklist HTML — a run of <li>s per project, aligned to
    focus['projects'] order — sourced from the SAME focus_projects.render_checklist()
    the morning brief renders (imported the way brief.py does). This gives the
    dashboard's expanded cards the brief's full next-step narrative — close-outs
    ("… merged; issue still open — close it?"), batched next-steps with refs, and
    the estimate/priority gap line — instead of bare issue ids. Best-effort: any
    import/render/parse problem returns None and render_focus falls back to the
    id+title lists, so the focus engine can never break the dashboard."""
    try:
        import importlib.util
        path = (ROOT / "loops" / "focus-projects" / ".claude" / "skills"
                / "focus-projects" / "scripts" / "focus_projects.py")
        spec = importlib.util.spec_from_file_location("focus_projects", str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        model = {"projects": focus.get("projects", []),
                 "generated_at": focus.get("generated_at")}
        if focus.get("batch_cap") is not None:
            model["batch_cap"] = focus["batch_cap"]
        md = mod.render_checklist(model)
    except Exception:  # pragma: no cover - focus engine is optional
        return None
    # render_checklist emits one '## <project>' heading per project, in model
    # order, each followed by its '- [ ] …' / '⚑ …' body lines. Split on those
    # headings; the '# 🎯' title, '---' rule and '_…_' footer/"nothing" notes
    # fall outside a section (or are italic) and are dropped.
    sections: list[list[str]] = []
    cur: list[str] | None = None
    for line in md.splitlines():
        if line.startswith("## "):
            cur = []
            sections.append(cur)
        elif cur is not None:
            s = line.strip()
            if not s or s.startswith("---") or s.startswith("_"):
                continue
            if s.startswith("- [ ] "):
                s = s[len("- [ ] "):]
            cur.append(_focus_check_li(s))
    if len(sections) != len(focus.get("projects", [])):
        return None  # unexpected shape — fall back rather than misalign cards
    return ["".join(sec) for sec in sections]


def render_focus(focus: dict) -> str:
    """Layout A — one momentum card per focus project: progress + target, the
    single highest-leverage batch (▶ headline), the runner-up (then), and a
    compact issue/flag meta line. Inline styles reuse the dashboard CSS vars."""
    if not focus.get("available"):
        return ('<div class="empty"><div class="sm">No focus projects yet — '
                'run <code>focus_projects.py refresh</code>.</div></div>')
    checklists = _focus_checklists(focus)
    cards = []
    for idx, p in enumerate(focus["projects"]):
        prog = p.get("progress")
        pct = int(round(prog * 100)) if isinstance(prog, (int, float)) else None
        bar = ""
        if pct is not None:
            bar = (f'<span style="display:inline-block;width:66px;height:6px;'
                   f'border-radius:3px;background:var(--raise);overflow:hidden;'
                   f'vertical-align:middle"><span style="display:block;height:100%;'
                   f'width:{pct}%;background:var(--good)"></span></span>'
                   f'<span style="color:var(--dim);font-size:11px;margin-left:6px">'
                   f'{pct}%</span>')
        tgt_txt = (f'target {p["target_date"]}' if p.get("target_date")
                   else "no target")
        # id -> title from the per-issue gap data, used to flesh out the
        # expanded issue list below.
        titles = {g["id"]: g.get("title")
                  for g in (p.get("gaps") or []) if g.get("id")}
        rich = checklists[idx] if checklists else None
        h = p.get("headline")
        if rich:
            # Rich path — the SAME per-project checklist the morning brief
            # renders, inside a real <details class="obs"> (the .obs CSS
            # supplies the ▸/▾ marker). The runner-up ('then') batch is already
            # folded into this one list, so there's no separate 'then' dropdown.
            ids = (h or {}).get("ids", [])
            label = f'{E(h["summary"])} · {len(ids)}' if h else "Needs you"
            hl = (f'<details class="obs" style="margin-top:7px">'
                  f'<summary>{label}</summary>'
                  f'<ul style="margin:6px 0 0;padding:0">{rich}</ul></details>')
            then_html = ""
        elif h:
            # Fallback (focus engine unavailable / empty checklist): the
            # pre-parity id+title lists.
            ids = h.get("ids", [])
            hl = (f'<details class="obs" style="margin-top:7px">'
                  f'<summary>{E(h["summary"])} · {len(ids)}</summary>'
                  f'<ul style="margin:6px 0 0;padding:0">'
                  f'{_focus_issue_lis(ids, titles)}</ul></details>')
            then = p.get("then")
            then_html = ""
            if then:
                tids = then.get("ids", [])
                then_html = (f'<details class="obs" style="margin-top:4px">'
                             f'<summary>then · {E(then["summary"])} · {len(tids)}'
                             f'</summary><ul style="margin:6px 0 0;padding:0">'
                             f'{_focus_issue_lis(tids, titles)}</ul></details>')
        else:
            # Genuinely empty state — no affordance, so no ▸ glyph.
            hl = ('<div style="margin:7px 0 2px;font-size:12px;color:var(--faint)">'
                  'no actionable batch right now</div>')
            then_html = ""
        gaps = len(p.get("gaps") or [])
        others = len(p.get("others") or [])
        flags = []
        if gaps:
            flags.append(f"⚑{gaps} need est/priority")
        if others:
            flags.append(f"👤{others} owned by others")
        meta = (f'{p.get("issue_count", 0)} issues'
                + (" · " + " · ".join(flags) if flags else ""))
        cards.append(f'''
      <div style="padding:10px 2px;border-bottom:1px solid var(--hair)">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <span style="font-weight:600;color:var(--ink);font-size:13px">{E(p["name"])}</span>
          <span style="flex:1"></span>{bar}
          <span style="color:var(--faint);font-size:11px">{E(tgt_txt)}</span>
        </div>
        {hl}{then_html}
        <div style="font-size:10.5px;color:var(--faint)">{E(meta)}</div>
      </div>''')
    return "".join(cards)


def render_night(night: dict) -> str:
    rep = night["report"]
    rep_line = ""
    if rep["done"] is not None:
        # `failed` shows only when there were failures — a standing "0 failed"
        # is noise, and a night that failed nothing should not look like one
        # that was never checked.
        failed = (f' · <span style="color:var(--crit)">{rep["failed"]} failed</span>'
                  if rep.get("failed") else "")
        rep_line = (f'<div style="font-size:11px;color:var(--faint);margin:0 2px 10px">'
                    f'last night ({E(rep["date"] or "")}) · '
                    f'<span style="color:var(--good)">{rep["done"]} done</span>{failed} · '
                    f'<span style="color:var(--crit)">{rep["needs_you"] or 0} '
                    f'needs you</span></div>')
    rows = []
    for it in night["queue"]:
        st = it["status"]
        st_cls = st.replace("-", "").replace("_", "")
        kind = ('<span class="kindmark">task</span>'
                if it["kind"] == "task" else "")
        lin = (f'<span class="kindmark" style="color:var(--info);border-color:var(--info);'
               f'background:var(--info-soft)">{E(it["linear"])}</span>'
               if it.get("linear") else "")
        reason = (f'<div class="qreason">{E(it["reason"])}</div>'
                  if it.get("reason") else "")
        rows.append(f'''
      <div class="qrow">
        <div class="qbody">
          <div class="qid">{E(it["id"])}{kind}{lin}</div>
          <div class="qttl">{E(it["title"])}</div>
          {reason}
        </div>
        <span class="status {st_cls}">{E(st)}</span>
      </div>''')
    if not rows:
        rows.append('<div class="empty"><div class="sm">Queue is empty.</div></div>')
    return rep_line + "".join(rows)


def render_mechanic(mech: dict) -> str:
    props = []
    for p in mech["proposals"]:
        tag = f'<span class="pt">{E(p["tag"])}</span>' if p["tag"] else ""
        body = f'<div class="pbd">{E(p["body"])}</div>' if p["body"] else ""
        props.append(f'''
      <div class="prop">
        <div class="ph">{tag}<span class="pname">{E(p["title"])}</span></div>
        {body}
      </div>''')
    if not props:
        props.append('<div class="empty"><div class="sm">No pending proposals.</div></div>')
    obs = ""
    if mech["observations"]:
        items = "".join(f"<li>{E(o)}</li>" for o in mech["observations"])
        obs = (f'<details class="obs"><summary>{len(mech["observations"])} '
               f'observations (no action)</summary><ul style="margin:6px 0 0;padding:0">'
               f'{items}</ul></details>')
    applied = ""
    if mech["applied"] and "none" not in mech["applied"].lower():
        applied = (f'<div style="font-size:11px;color:var(--good);margin-top:10px">'
                   f'applied autonomously: {E(mech["applied"])}</div>')
    return "".join(props) + applied + obs


_BRIEF_BOLD_RE = re.compile(r"\*\*([^*\n]+)\*\*|\*([^*\n]+)\*")
_BRIEF_LINK_RE = re.compile(r"\[([^\]\n]+)\]\((https?://[^\s)]+)\)")


def render_brief_markdown(raw: str) -> str:
    """Turn the morning-brief's markdown (**bold**/*bold*, [text](url) links)
    into safe HTML. Escapes the whole body FIRST, then applies allow-listed
    substitutions on the escaped text — no path from brief content to
    unescaped markup, and only http(s) links become <a href>."""
    body = E(raw)
    body = _BRIEF_LINK_RE.sub(
        lambda m: f'<a href="{m.group(2)}" target="_blank" rel="noopener">{m.group(1)}</a>',
        body)
    return _BRIEF_BOLD_RE.sub(
        lambda m: f"<b>{m.group(1) or m.group(2)}</b>", body)


DELIVERY_NOTE = {
    "delivered": "relayed to Slack",
    "pending": "NOT relayed yet",
    "delivering": "relay in flight",
    "unpublished": "NOT published — nothing was handed to the hub",
    "abandoned": "never relayed",
}


def brief_delivery_note(delivery: dict | None) -> str:
    """One phrase saying whether the operator actually received this brief.

    On EVERY brief that has a record, not only the undelivered ones — P-03's
    rule about freshness fields applies here for the same reason: a line that
    appears only when something is wrong is a line the reader stops seeing.
    A brief with no record at all says nothing, because a pre-P-10 report file
    is not evidence either way.
    """
    if not delivery:
        return ""
    note = DELIVERY_NOTE.get(delivery.get("status"))
    if not note:
        return ""
    if delivery.get("status") == "abandoned" and delivery.get("reason"):
        note += f" ({delivery['reason']})"
    tries = delivery.get("attempts") or 0
    if tries > 1 or (tries and delivery.get("status") != "delivered"):
        note += f" · {tries} attempt{'s' if tries != 1 else ''}"
    return note


# P-11. One chip per source, rendered FROM the manifest — the status and the
# freshness budget are the brief's own, not this file's second opinion. The
# only thing computed here is the age, and SOURCE_JS re-computes that in the
# browser from the same `data-asof` / `data-maxage` pair, so a panel left open
# all day goes amber on its own instead of lying until the next regeneration.
SOURCE_STATE_TITLE = {
    brief_manifest.COMPLETED: "completed — an empty result here is real",
    brief_manifest.FAILED: "FAILED — an empty result here means nobody looked",
    brief_manifest.UNAVAILABLE: "unavailable — this fetch never ran",
}


def render_source_chip(env: dict) -> str:
    status = str(env.get("status") or "")
    stale = env.get("staleness") or {}
    as_of = stale.get("as_of") or ""
    max_age = stale.get("max_age_seconds") or 0
    fresh = stale.get("state") or brief_manifest.UNKNOWN
    label = brief_manifest.SOURCE_LABEL.get(env.get("source"),
                                            str(env.get("source")))
    count = env.get("count")
    # The degrade is a separate class from the status on purpose: it is a
    # `completed` source whose emptiness still is not evidence, and collapsing
    # it into `failed` would overstate what went wrong.
    degraded = " deg" if env.get("degraded") else ""
    tip = SOURCE_STATE_TITLE.get(status, status)
    if env.get("degraded"):
        tip += " · partly unread"
    if env.get("why"):
        tip += f" · {env['why']}"
    age = (human_age(stale.get("age_seconds"))
           if stale.get("age_seconds") is not None else "—")
    n = "" if count is None else f'<span class="srcn">{E(str(count))}</span>'
    return (f'<span class="srcchip s-{E(status)} f-{E(fresh)}{degraded}" '
            f'title="{E(tip)}" data-asof="{E(as_of)}" '
            f'data-maxage="{E(str(max_age))}">'
            f'<span class="srcdot"></span>'
            f'<span class="srcname">{E(label)}</span>{n}'
            f'<span class="srcage">{E(age)}</span></span>')


def render_brief_sources(brief: dict) -> str:
    """The provenance strip above the brief body: what each gatherer saw."""
    manifest = brief.get("manifest") or {}
    if manifest.get("legacy") or not manifest.get("sources"):
        return ('<div class="srcstrip legacy" title="'
                + E(str(manifest.get("why") or brief_manifest.LEGACY_WHY))
                + '">no source manifest — nothing recorded what this brief '
                  'could see</div>')
    order = [s for s in brief_manifest.SOURCES if s in manifest["sources"]]
    order += [s for s in sorted(manifest["sources"]) if s not in order]
    chips = "".join(render_source_chip(manifest["sources"][s]) for s in order)
    bad = brief_manifest.incomplete_sources(manifest)
    lines = [f'<div class="srcstrip">{chips}</div>']
    if bad:
        names = ", ".join(
            f"{brief_manifest.SOURCE_LABEL.get(e['source'], e['source'])} "
            f"({e['outcome']})" for e in bad)
        lines.append(
            f'<div class="srcwarn">{len(bad)} source(s) could not answer for '
            f'themselves — an empty section below is not evidence of a quiet '
            f'morning: {E(names)}</div>')
    cut = manifest.get("ledger_cutoff") or {}
    if brief.get("board_moved"):
        lines.append(
            '<div class="srcwarn">the PR board above has changed since this '
            'brief read it — the panel is live, the digest is this morning\'s '
            'snapshot</div>')
    seq = cut.get("seq")
    if seq is not None:
        lines.append(f'<div class="srccut">ledger cutoff · event {E(str(seq))}'
                     f'</div>')
    return "".join(lines)


def render_brief(brief: dict, loops: list[dict]) -> str:
    if brief.get("available"):
        note = brief_delivery_note(brief.get("delivery"))
        tail = f' · {E(note)}' if note else ""
        return (f'<div style="font-size:10.5px;color:var(--faint);margin-bottom:8px">'
                f'{E(brief["name"])}{tail}</div>'
                f'{render_brief_sources(brief)}'
                f'<div class="brief-body scroll">'
                f'{render_brief_markdown(brief["body"])}</div>')
    briefer = next((l for l in loops if l["name"] == "morning-brief"), None)
    armed = briefer and briefer["session_present"]
    state = ("armed & heartbeating" if armed else "session down")
    return f'''
    <div class="empty">
      <div class="big">First brief lands tomorrow morning</div>
      <div class="sm">The briefer composes one digest per day inside the
        06:00–09:00 local window — an act-first two-lane read (needs-you PRs +
        review comments to address) over the estate. No pass has run yet.</div>
      <div class="badge">the briefer · {E(state)}</div>
    </div>'''


def render_ledger(rows: list[dict]) -> str:
    out = []
    for r in rows:
        ts = r.get("ts", "")
        try:
            if isinstance(ts, (int, float)):
                t = datetime.fromtimestamp(ts, tz=timezone.utc).astimezone().strftime("%H:%M")
            else:
                t = (datetime.fromisoformat(ts.replace("Z", "+00:00"))
                     .astimezone().strftime("%H:%M"))
        except (ValueError, AttributeError, OSError):
            tm = re.search(r"T(\d{2}:\d{2})", str(ts))
            t = tm.group(1) if tm else str(ts)[:5]
        # Rows arrive normalized from build_ledger, but render_ledger is also
        # called with raw rows in tests and by hand, so fold again — normalize
        # is idempotent.
        who = actors.normalize(r.get("actor"), r.get("session_id"))
        acls = {actors.CLASS_OPERATOR: "hub", actors.CLASS_EPHEMERAL: "eph"}.get(who.actor_class, "")
        kind = r.get("kind", "activity")
        short = who.short
        out.append(f'''
      <div class="led {E(kind)}">
        <span class="t">{E(t)}</span>
        <span class="a {acls}">{E(short)}</span>
        <span class="s">{E(r.get("summary",""))}</span>
      </div>''')
    return "".join(out)


def render_ephemeral(items: list[dict]) -> str:
    if not items:
        return ('<div class="empty"><div class="sm">No ephemeral sessions in '
                'flight. Dispatched workers appear here the moment the hub spins '
                'them up.</div></div>')
    cards = []
    for it in items:
        st = it["status"] or "?"
        lamp = {"running": "run beat", "waiting": "wait", "idle": "idle"}.get(st, "run")
        st_cls = st.replace("-", "").replace("_", "")
        age = human_age(it["age"]) if it["age"] is not None else "—"
        ref = (f'<div class="es-ref">{E(str(it["ref"]))}</div>'
               if it.get("ref") else "")
        kind = (f'<span class="es-kind">{E(str(it["kind"]))}</span>'
                if it.get("kind") else "")
        cards.append(f'''
      <div class="ephcard">
        <span class="lamp {lamp}" title="{E(st)}"></span>
        <div class="es-body">
          <div class="es-slug" title="{E(it.get("path") or "")}">{E(it["slug"])}</div>
          {ref}
          <div class="es-meta">
            <span class="status {st_cls}">{E(st)}</span>
            {kind}
            <span class="es-age">{E(age)} alive</span>
          </div>
        </div>
      </div>''')
    return f'<div class="ephstrip">{"".join(cards)}</div>'


def cap_pace(pct: float, resets_at: str, *, hours: float,
             reserve_pct: float = 0, now: datetime | None = None) -> tuple[int, str] | None:
    """Expected linear consumption and severity for a bounded usage window."""
    try:
        reset = datetime.fromisoformat(resets_at.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None
    if reset.tzinfo is None:
        reset = reset.replace(tzinfo=timezone.utc)
    current = now or datetime.now(timezone.utc)
    start = reset - timedelta(hours=hours)
    elapsed = max(0.0, min(hours, (current - start).total_seconds() / 3600))
    if reserve_pct and hours == 168:
        weekday_hours = 120.0
        if elapsed <= weekday_hours:
            expected = elapsed / weekday_hours * (100 - reserve_pct)
        else:
            expected = ((100 - reserve_pct) +
                        (elapsed - weekday_hours) / 48.0 * reserve_pct)
    else:
        expected = elapsed / hours * 100
    severity = "good" if pct < expected - 3 else ("crit" if pct > expected + 3 else "warn")
    return round(expected), severity


def render_cap(cap: dict | None) -> str:
    """Account-wide usage cap %/spend status from state/usage/budget.json —
    the SAME signal review.py's budget guard gates on. "account" when
    bin/usage-fetch's authenticated call worked, "local proxy" when it fell
    back to the token estimate, absent entirely if usage-fetch hasn't run."""
    if not cap:
        return ('<span class="sep">·</span><span class="est">cap: not '
                'populated — run bin/usage-fetch</span>')
    source = cap.get("source", "?")
    parts = []
    for key, label in (("session_pct", "session"), ("weekly_pct", "weekly"),
                        ("spend_pct", "spend")):
        v = cap.get(key)
        if isinstance(v, (int, float)):
            pace = None
            if key == "weekly_pct":
                pace = cap_pace(v, cap.get("weekly_resets_at"), hours=168,
                                reserve_pct=10)
            elif key == "session_pct":
                pace = cap_pace(v, cap.get("session_resets_at"), hours=5)
            if pace:
                expected, severity = pace
                parts.append(f'<span class="pace {severity}">{label} {v:g}% '
                             f'(pace {expected}%)</span>')
            else:
                parts.append(f"{label} {v:g}%")
    if cap.get("spend_blocked"):
        parts.append("SPEND BLOCKED")
    body = " · ".join(parts) if parts else "no signal"
    src_label = {"api": "account", "local_estimate": "local proxy",
                 "unavailable": "unavailable", "absent": "absent",
                 "error": "unreadable"}.get(source, source)
    return (f'<span class="sep">·</span><span class="pct" '
            f'title="account usage cap — source: {E(src_label)}">'
            f'cap {body} ({E(src_label)})</span>')


def render_loop_costs(rows: list[dict] | None) -> str:
    """Per-loop cost chips under the header usage line — top 4 by spend this
    window. Full per-loop and per-session breakdowns are always in the JSON
    payload (usage.cost_by_loop / usage.top_sessions) even when not all of
    it is rendered here."""
    if not rows:
        return ""
    chips = " ".join(
        f'<span class="chip" title="{r["tokens"]:,} tokens">'
        f'{E(r["loop"])} ${r["cost_usd"]:.2f}</span>'
        for r in rows[:4] if r["cost_usd"] > 0)
    if not chips:
        return ""
    return (f'<div style="flex-basis:100%;height:0"></div>'
            f'<span class="ul" style="margin-top:4px">by loop</span>{chips}')


def render_usage(u: dict) -> str:
    """Compact header line — LOCAL rolling-window token+cost estimate, plus
    the account-wide cap % (state/usage/budget.json, see render_cap)."""
    cap_html = render_cap((u or {}).get("cap"))
    if not u or not u.get("available"):
        reason = (u or {}).get("reason") or "no local usage data"
        return ('<span class="ul">Claude usage</span>'
                f'<span class="est">unavailable — {E(reason)}</span>'
                f'{cap_html}')
    h = u["window_hours"]
    hlabel = f"{h:g}h"
    title = (f'Local Claude Code usage, last {hlabel} (this host only). '
             f'in {u["input"]:,} · out {u["output"]:,} · '
             f'cache-create {u["cache_creation"]:,} · cache-read {u["cache_read"]:,} · '
             f'{u["messages"]:,} messages across {u["sessions"]} sessions. '
             f'{u["note"]}. {u.get("pricing_note", "")}')
    pct = ""
    if u.get("pct_of_budget") is not None:
        pct = (f'<span class="sep">·</span><span class="pct">{u["pct_of_budget"]}% '
               f'of budget</span>')
    cost = ""
    if u.get("cost_usd") is not None:
        cost = f'<span class="sep">·</span><b>${u["cost_usd"]:.2f}</b> est.'
    return (
        f'<span class="ul" title="{E(title)}">Claude · last {E(hlabel)}</span>'
        f'<b>{E(human_tokens(u["output"]))}</b> out'
        f'<span class="sep">·</span><b>{E(human_tokens(u["total"]))}</b> total'
        f'{cost}'
        f'<span class="sep">·</span>{u["sessions"]} sessions'
        f'{pct}'
        f'<span class="sep">·</span><span class="est">local est.</span>'
        f'{cap_html}'
        f'{render_loop_costs(u.get("cost_by_loop"))}')


def render_vitals(s: dict) -> str:
    """Inner HTML of the .vitals row — shared by the live shell and fragment."""
    v = s["vitals"]
    live_total = sum(1 for l in s["loops"] if l["autostart"] or l["is_hub"])
    needs_cls = "alert" if v["needs_you"] else ""
    astray_cls = "alert" if v["going_astray"] else "calm"
    return (
        f'<div class="vital go"><div class="n">{v["loops_live"]}'
        f'<span style="font-size:13px;color:var(--faint)">/{live_total}</span></div>'
        f'<div class="l">loops live</div></div>'
        f'<div class="vital {needs_cls}"><div class="n">{v["needs_you"]}</div>'
        f'<div class="l">needs you</div></div>'
        f'<div class="vital {astray_cls}"><div class="n">{v["going_astray"]}</div>'
        f'<div class="l">going astray</div></div>'
        f'<div class="vital warn"><div class="n">{v["queue_queued"]}</div>'
        f'<div class="l">queued</div></div>'
        f'<div class="vital"><div class="n">{v["proposals"]}</div>'
        f'<div class="l">proposals</div></div>')


def render_body(s: dict) -> str:
    gen_dt = s["generated_at"].replace("+00:00", "Z")

    return f'''
  <div class="wrap">
    <header class="masthead">
      <div class="brand">
        <div class="eyebrow">Autonomous operations estate</div>
        <div class="title">
          <span class="pulse" title="operator live"></span>
          <span class="estate">{E(s["estate"])}</span>
          <span class="sep">/</span>
          <span class="operator">{E(s["operator"])}</span>
        </div>
        <div class="subline">snapshot <b id="gen-rel" data-epoch="{s["generated_epoch"]}">just now</b>
          · {E(gen_dt)} · host <b>{E(s["host"])}</b></div>
        <div class="usage" id="usage">{render_usage(s["usage"])}</div>
      </div>
      <span class="spacer"></span>
      <div class="vitals">{render_vitals(s)}</div>
      <button class="themebtn" id="themebtn" type="button" aria-label="Toggle theme">☾ Night shift</button>
    </header>

    <div class="grid">
      <section class="panel col-7">
        <div class="phead"><span class="k">Loops</span><span class="grow"></span>
          <span class="tick">persona · model · interval · heartbeat</span></div>
        <div class="pbody tight">{render_loops(s["loops"])}</div>
        <div class="panel-subhead"><span class="k">Ephemeral queue</span><span class="grow"></span>
          <span class="tick">in flight now · {len(s["ephemeral"])} dispatched</span></div>
        <div class="pbody tight ephemeral-body">{render_ephemeral(s["ephemeral"])}</div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Night-shift queue</span><span class="grow"></span>
          <span class="tick">the night shift</span></div>
        <div class="pbody tight scroll">{render_night(s["night"])}</div>
      </section>

      <section class="panel col-12">
        <div class="phead"><span class="k">Focus projects</span><span class="grow"></span>
          <span class="tick">momentum · the spotter</span></div>
        <div class="pbody">{render_focus(s["focus"])}</div>
      </section>

      <section class="panel col-7">
        <div class="phead"><span class="k">PR board</span><span class="grow"></span>
          <span class="tick">the spotter · your court first</span></div>
        <div class="pbody">{render_pr_board(s["pr_board"])}</div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Mechanic proposals</span><span class="grow"></span>
          <span class="tick">night of {E(s["mechanic"]["date"] or "—")}</span></div>
        <div class="pbody">{render_mechanic(s["mechanic"])}</div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Daily digest</span><span class="grow"></span>
          <span class="tick">the briefer</span></div>
        <div class="pbody">{render_brief(s["brief"], s["loops"])}</div>
      </section>

      <section class="panel col-7">
        <div class="phead"><span class="k">Recent activity</span><span class="grow"></span>
          <span class="tick">ledger · last {len(s["ledger"])}</span></div>
        <div class="pbody tight scroll">{render_ledger(s["ledger"])}</div>
      </section>
    </div>

    <footer class="foot">
      <span>Static snapshot · pure reader · no auto-refresh</span>
      <span>regenerate with <code>bin/dashboard</code></span>
    </footer>
  </div>'''


# ── Tier-1 live shell ────────────────────────────────────────────────────────
# The static page bin/ops serves at 127.0.0.1. It carries NO data — it fetches
# state/dashboard.json (same origin, the only network call) and renders the
# sections client-side in place. Structure mirrors render_body but every dynamic
# region is an empty id'd container that SHELL_JS fills from the JSON.

def render_shell_body(s: dict, *, brief_tick: str = "the briefer") -> str:
    return f'''
  <div class="wrap">
    <header class="masthead">
      <div class="brand">
        <div class="eyebrow">Autonomous operations estate</div>
        <div class="title">
          <span class="pulse" title="operator live"></span>
          <span class="estate">{E(s["estate"])}</span>
          <span class="sep">/</span>
          <span class="operator">{E(s["operator"])}</span>
        </div>
        <div class="subline">snapshot <b id="gen-rel">…</b>
          · <span id="gen-abs">…</span> · host <b id="gen-host">…</b></div>
        <div class="usage" id="usage"></div>
      </div>
      <span class="spacer"></span>
      <div class="vitals" id="vitals"></div>
      <button class="themebtn" id="themebtn" type="button" aria-label="Toggle theme">☾ Night shift</button>
    </header>

    <div class="grid">
      <section class="panel col-7">
        <div class="phead"><span class="k">Loops</span><span class="grow"></span>
          <span class="tick">persona · model · interval · heartbeat</span></div>
        <div class="pbody tight" id="sec-loops"></div>
        <div class="panel-subhead"><span class="k">Ephemeral queue</span><span class="grow"></span>
          <span class="tick">in flight now · <span id="eph-count">0</span> dispatched</span></div>
        <div class="pbody tight ephemeral-body" id="sec-ephemeral"></div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Night-shift queue</span><span class="grow"></span>
          <span class="tick">the night shift</span></div>
        <div class="pbody tight scroll" id="sec-night"></div>
      </section>

      <section class="panel col-12">
        <div class="phead"><span class="k">Focus projects</span><span class="grow"></span>
          <span class="tick">momentum · the spotter</span></div>
        <div class="pbody" id="sec-focus"></div>
      </section>

      <section class="panel col-7">
        <div class="phead"><span class="k">PR board</span><span class="grow"></span>
          <span class="tick">the spotter · your court first</span></div>
        <div class="pbody" id="sec-pr"></div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Mechanic proposals</span><span class="grow"></span>
          <span class="tick">night of <span id="mech-date">—</span></span></div>
        <div class="pbody" id="sec-mech"></div>
      </section>

      <section class="panel col-5">
        <div class="phead"><span class="k">Daily digest</span><span class="grow"></span>
          <span class="tick">{E(brief_tick)}</span></div>
        <div class="pbody" id="sec-brief"></div>
      </section>

      <section class="panel col-7">
        <div class="phead"><span class="k">Recent activity</span><span class="grow"></span>
          <span class="tick">ledger · last <span id="led-count">0</span></span></div>
        <div class="pbody tight scroll" id="sec-ledger"></div>
      </section>
    </div>

    <footer class="foot">
      <span class="stat" id="livestat"><span class="sdot"></span>
        <b id="livestat-label">connecting…</b> · Tier-1 live · pure reader</span>
      <span>auto-refresh 30s · served locally · regen <code>bin/dashboard --json</code></span>
    </footer>
  </div>'''


SHELL_SECTIONS = {
    "loops": "sec-loops",
    "ephemeral": "sec-ephemeral",
    "night": "sec-night",
    "focus": "sec-focus",
    "pr_board": "sec-pr",
    "mechanic": "sec-mech",
    "brief": "sec-brief",
    "ledger": "sec-ledger",
}


def render_shell(s: dict, *, extra_css: str = "", extra_js: str = "",
                 unmanaged_sections: tuple[str, ...] = (),
                 brief_tick: str = "the briefer") -> str:
    """Render the live shell with explicit hooks for the primary UI layer.

    ``unmanaged_sections`` removes regions from the base live updater so a
    specialized renderer can own them. Extra CSS and JavaScript remain inlined,
    preserving the dashboard's self-contained shell contract.
    """
    title = f'🐱 {s["estate"]} / {s["operator"]} — estate dashboard'
    body = render_shell_body(s, brief_tick=brief_tick)
    sections = {k: v for k, v in SHELL_SECTIONS.items()
                if k not in unmanaged_sections}
    section_config = ("<script>window.OPS_DASH_SECTIONS="
                      + json.dumps(sections, separators=(",", ":"))
                      + ";</script>\n")
    return (f'<!doctype html>\n<html lang="en" data-theme="dark">\n<head>\n'
            f'<meta charset="utf-8">\n'
            f'<meta name="viewport" content="width=device-width, initial-scale=1">\n'
            f'<link rel="icon" href="{FAVICON}">\n'
            f'<title>{E(title)}</title>\n<style>{CSS}\n{extra_css}</style>\n</head>\n'
            f'<body>\n{body}\n{section_config}'
            f'<script>{SOURCE_JS}\n{SHELL_JS}\n{ACK_JS}\n{extra_js}</script>\n'
            f'</body>\n</html>\n')


def render_fragment(s: dict) -> str:
    """Data-inlined body fragment for the Artifact tool (static; no fetch)."""
    title = f'{s["estate"]} / {s["operator"]} — estate dashboard'
    body = render_body(s)
    style = f"<style>{CSS}</style>"
    script = f"<script>{JS}\n{SOURCE_JS}</script>"
    return f'<title>{E(title)}</title>\n{style}\n{body}\n{script}\n'


# ── payload assembly ─────────────────────────────────────────────────────────

def build_payload(s: dict) -> dict:
    """The dashboard.json body: the full data model PLUS the pre-rendered
    section/vitals HTML the live shell drops into the DOM. Same render_*
    functions feed the Artifact fragment, so the two never diverge."""
    return {
        **s,
        "tier": 1,
        "vitals_html": render_vitals(s),
        "usage_html": render_usage(s["usage"]),
        "sections": {
            "loops": render_loops(s["loops"]),
            "ephemeral": render_ephemeral(s["ephemeral"]),
            "night": render_night(s["night"]),
            "focus": render_focus(s["focus"]),
            "pr_board": render_pr_board(s["pr_board"]),
            "mechanic": render_mechanic(s["mechanic"]),
            "brief": render_brief(s["brief"], s["loops"]),
            "ledger": render_ledger(s["ledger"]),
        },
    }


# ── main ─────────────────────────────────────────────────────────────────────

def main() -> int:
    snap = build_snapshot()
    payload = build_payload(snap)
    json_out = STATE / "dashboard.json"
    json_out.write_text(json.dumps(payload, indent=2), encoding="utf-8")

    if "--json" in sys.argv:
        # Regenerator path: data model only. Deterministic + token-free — this
        # is what the local dashboard-refresh service runs every ~45s. It NEVER
        # rewrites the shell or fragment and never touches any loop's state.
        print(f"wrote {json_out}  ({json_out.stat().st_size:,} bytes, --json)")
        return 0

    # Default: also (re)write the data-inlined Artifact fragment. The primary
    # live shell is generated by bin/dashboard-index.
    frag_out = STATE / "dashboard.body.html"
    fragment = render_fragment(snap)
    frag_out.write_text(fragment, encoding="utf-8")
    print(f"wrote {json_out}  ({json_out.stat().st_size:,} bytes, data model)")
    print(f"wrote {frag_out}  ({len(fragment):,} bytes, Artifact fragment)")
    v = snap["vitals"]
    print(f"  loops {v['loops_live']} live / {v['loops_ondemand']} on-demand · "
          f"needs-you {v['needs_you']} · astray {v['going_astray']} · "
          f"queued {v['queue_queued']} · proposals {v['proposals']}")
    print("  serve locally:  flox activate --start-services  ·  url: bin/ops dashboard")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
