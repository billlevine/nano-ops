#!/usr/bin/env python3
"""doorbell — zero-token fast poller for the hub's control channel.

Polls the Slack self-DM every POLL_S seconds using a personal Slack user
token (stdlib only, no model calls). When a message newer than the hub's
cursor appears that isn't a hub post (⚙️ prefix), it kicks the hub session
via `agent-deck session send` so the hub ticks immediately instead of waiting
out its idle backoff. Read-only by design: never advances the cursor,
never replies — the hub stays the single writer.

Operator identity (which agent-deck session to kick, under which profile) is
NOT baked in: it comes from loops.toml [hub] — see loops.example.toml.
"""
import json
import os
import subprocess
import sys
import time
import tomllib
import urllib.parse
import urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOKEN_FILE = os.path.join(REPO, "state", "secrets", "slack-user-token")
HUB_DIR = os.path.join(REPO, "state", "hub")
HUB_CURSOR = os.path.join(HUB_DIR, "cursor")
DOORBELL_ALIVE = os.path.join(HUB_DIR, "doorbell_alive")
STATE_DIR = os.path.join(REPO, "state", "doorbell")
LAST_KICK = os.path.join(STATE_DIR, "last_kick")
POLL_S = 30
KICK_COOLDOWN_S = 120
KICK_MSG = "doorbell: new control-channel activity — run one hub tick now"


def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def hub_config() -> dict:
    """loops.toml [hub] — the per-installation operator identity. Never raises:
    a missing/unparseable registry degrades to defaults, and main() then exits
    on the missing channel id with a readable message."""
    try:
        with open(os.path.join(REPO, "loops.toml"), "rb") as f:
            hub = tomllib.load(f).get("hub", {})
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return hub if isinstance(hub, dict) else {}


HUB = hub_config()
# Persona is the display half of the agent-deck title convention
# "<persona> (<loop name>)"; the hub's loop name is "hub". Public default is the
# neutral "ops" — a real install sets its own in loops.toml.
HUB_PERSONA = HUB.get("persona") or "ops"
HUB_SESSION = HUB.get("session_title") or f"{HUB_PERSONA} (hub)"
DECK_PROFILE = (os.environ.get("DOORBELL_DECK_PROFILE")
                or HUB.get("deck_profile") or "ops")


def channel_id():
    return HUB.get("slack_channel_id")


def fetch_messages(token, channel):
    query = urllib.parse.urlencode({"channel": channel, "limit": 10})
    req = urllib.request.Request(
        f"https://slack.com/api/conversations.history?{query}",
        headers={"Authorization": f"Bearer {token}"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.load(resp)
    if not data.get("ok"):
        raise RuntimeError(f"slack api error: {data.get('error')}")
    return data.get("messages", [])


def needs_kick(messages):
    cursor = float(read_file(HUB_CURSOR, "0") or 0)
    for m in messages:
        if m.get("subtype"):  # edits, joins, etc.
            continue
        text = m.get("text", "")
        if text.startswith("⚙") or text.startswith(":gear:"):
            continue  # hub's own post
        if float(m["ts"]) > cursor:
            return m["ts"]
    return None


def kick():
    result = subprocess.run(
        ["agent-deck", "-p", DECK_PROFILE, "session", "send", HUB_SESSION, KICK_MSG],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if result.returncode != 0:
        print(f"doorbell: kick failed: {result.stderr.strip()}", file=sys.stderr, flush=True)
    return result.returncode == 0


def mark_alive():
    """Stamp DOORBELL_ALIVE every poll iteration, independent of Slack fetch
    outcome — this is what tells the dashboard the poller itself is up, so a
    long hub idle backstop doesn't read as the whole liveness chain being dead."""
    with open(DOORBELL_ALIVE, "w") as f:
        f.write(str(int(time.time())))


def main():
    token = read_file(TOKEN_FILE)
    if not token:
        sys.exit(f"doorbell: no token at {TOKEN_FILE}")
    channel = channel_id()
    if not channel:
        sys.exit("doorbell: no [hub].slack_channel_id in loops.toml")
    os.makedirs(STATE_DIR, exist_ok=True)
    os.makedirs(HUB_DIR, exist_ok=True)
    print(f"doorbell: watching {channel} every {POLL_S}s, "
          f"kicking {HUB_SESSION!r} (profile {DECK_PROFILE})", flush=True)
    while True:
        mark_alive()
        try:
            ts = needs_kick(fetch_messages(token, channel))
            if ts:
                last = float(read_file(LAST_KICK, "0") or 0)
                if time.time() - last >= KICK_COOLDOWN_S and kick():
                    with open(LAST_KICK, "w") as f:
                        f.write(str(time.time()))
                    print(f"doorbell: kicked hub for msg ts={ts}", flush=True)
        except Exception as exc:  # keep polling through transient failures
            print(f"doorbell: {exc}", file=sys.stderr, flush=True)
        time.sleep(POLL_S)


if __name__ == "__main__":
    main()
