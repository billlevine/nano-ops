#!/usr/bin/env python3
"""Generate the served dashboard shells: index.html, estate.html, dashboard-v2.html.

Every one of them is a DATA-FREE shell — it fetches state/dashboard.json at
runtime — so this only has to run when the markup itself changes, and the pages
stay as fresh as bin/dashboard-refresh keeps that JSON (45s). The snapshot is
built ONCE and handed to all three renderers: they read only the estate/operator
names out of it, so a second build would produce identical bytes at extra cost.
"""
from __future__ import annotations

import importlib.util
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "state" / "index.html"
ESTATE_OUT = ROOT / "state" / "estate.html"
V2_OUT = ROOT / "state" / "dashboard-v2.html"
sys.path.insert(0, str(ROOT / "lib"))

import dashboard_primary  # noqa: E402  (lib path is established above)
import dashboard_estate  # noqa: E402
import dashboard_v2  # noqa: E402


def load_dashboard():
    """Load the extensionless data/renderer module from bin/dashboard."""
    source = ROOT / "bin" / "dashboard"
    loader = SourceFileLoader("_estate_dashboard", str(source))
    spec = importlib.util.spec_from_loader("_estate_dashboard", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main() -> int:
    dashboard = load_dashboard()
    snapshot = dashboard.build_snapshot()
    page = dashboard_primary.render(dashboard, snapshot)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(page, encoding="utf-8")
    ESTATE_OUT.write_text(dashboard_estate.render(dashboard, snapshot), encoding="utf-8")
    V2_OUT.write_text(dashboard_v2.render(dashboard, snapshot), encoding="utf-8")
    print(f"wrote {OUT}  ({len(page):,} bytes, primary live shell)")
    print("  primary: /")
    print("  estate operations view: /estate.html")
    print("  dashboard v2: /dashboard-v2.html")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
