#!/usr/bin/env python3
"""Regenerate the served dashboard shells NOW: index.html, estate.html,
dashboard-v2.html.

Every one of them is a DATA-FREE shell — it fetches state/dashboard.json at
runtime — so the numbers on the pages stay as fresh as bin/dashboard-refresh
keeps that JSON (45s), whatever this does. What this writes is the MARKUP.

Now that is no longer this script's job alone: every `bin/dashboard`
run rewrites all three shells, including the `--json` one the dashboard-refresh
service drives every ~45s. So a merged rendering change reaches the served page
on its own, and this is the on-demand path — `bin/ops dashboard up`, and a
person who does not want to wait a cycle. Both call the same
`dashboard.write_shells`, so there is one renderer list and no second place for
a fourth page to be forgotten.

The snapshot is built ONCE and handed to all three renderers: they read only
the estate/operator names out of it, so a second build would produce identical
bytes at extra cost — and, before this, two builds could disagree about the
estate they were describing.
"""
from __future__ import annotations

import importlib.util
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
# The renderers are not imported here any more: `dashboard.write_shells` owns
# the page list, and importing them a second time would let this file's idea of
# it drift from the one the refresh cycle actually writes.
sys.path.insert(0, str(ROOT / "lib"))


def load_dashboard():
    """Load the extensionless data/renderer module from bin/dashboard."""
    source = ROOT / "bin" / "dashboard"
    loader = SourceFileLoader("_estate_dashboard", str(source))
    spec = importlib.util.spec_from_loader("_estate_dashboard", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main() -> int:
    dashboard = load_dashboard()
    for path, size in dashboard.write_shells(dashboard.build_snapshot()):
        print(f"wrote {path}  ({size:,} bytes, live shell)")
    print("  primary: /")
    print("  estate operations: /estate.html")
    print("  dashboard v2: /dashboard-v2.html")
    print("  stewards: /stewards.html (select a steward for its own page)")
    return 0



if __name__ == "__main__":
    raise SystemExit(main())
