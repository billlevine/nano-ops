#!/usr/bin/env python3
"""persona-compile — resolve the persona source layers into one file per role.

Reads personas/ (WORLDVIEW.md + HOUSE_STYLE.md + roles/<role>.md +
crews/<crew>.md, selected by personas/config.toml) and writes one compiled
persona per role to personas/compiled/<role>.md, plus MANIFEST.md recording
the selected crew and the content hash of every compiled body.

The compiled body is what actually enters a session's prompt. `--install`
writes it to a `persona.md` sidecar beside each target CLAUDE.md and puts a
`@persona.md` import between that file's generated markers.

The import matters: the harness resolves `@` when it injects CLAUDE.md, so the
body is in the prompt at startup and after auto-compaction. A prose reference
("load ./personas/compiled/<role>.md") is NOT equivalent — it depends on the
model choosing to Read the file, which can load nothing on a small model. Nor
is a non-sibling import: `@../../...` and absolute paths resolve to nothing.
Both verified; see docs/personas.md.

The payoff over inlining the body directly is that CLAUDE.md stays byte-stable
across recompiles. Only the sidecar changes when a persona changes, so a
persona edit no longer shows up as a diff in an operational-contract file.

Deterministic by construction: no timestamps, no environment, sorted output.
Compiling the same sources twice produces byte-identical files.

Usage:
    bin/persona-compile                 compile all roles into personas/compiled/
    bin/persona-compile --check         verify compiled/ and installed blocks
                                        are up to date (exit 1 on drift)
    bin/persona-compile --install       refresh the generated block in each
                                        target CLAUDE.md
    bin/persona-compile --role hub      restrict to one role
    bin/persona-compile --print hub     write the compiled body to stdout
    bin/persona-compile --wearing       what each RUNNING role is reading, not
                                        what the files on disk say (gap audit
                                        P-01). exit 3 superseded, 2 unknown

    --personas-dir DIR / --config FILE / --out DIR / --repo DIR override paths
    (used by the tests; defaults are all derived from the repo root).

Nothing here starts, stops, or talks to a session. Applying a compiled persona
to a running loop is a deliberate restart, done by hand — which is exactly why
`--wearing` exists: something has to name the window between installing a voice
and anybody speaking it, and `--check` cannot, because it compares files to
files.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib


def repo_root_of_script() -> str:
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


sys.path.insert(0, os.path.join(repo_root_of_script(), "lib"))

FENCE = re.compile(r"^\s*(```|~~~)")
HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)

SKIP_DIRS = {".git", ".flox", "node_modules", "state", "__pycache__"}

BEGIN = "<!-- BEGIN GENERATED PERSONA — bin/persona-compile"
END = "<!-- END GENERATED PERSONA -->"

# Filename of the sidecar written beside each target CLAUDE.md and imported by
# it. One fixed name for every target: each lives in its own directory, and the
# import is resolved relative to that directory.
SIDECAR = "persona.md"

# The one piece of prose the compiler itself owns. It pins the persona layer
# below the operational contract in every compiled output, so a persona can
# never be read as relaxing an authority or safety rule.
#
# House prose sits ABOVE role judgment in the published order, and that is the
# whole of gap-audit P-03. The order used to read "... then role judgment, then
# house prose ...", which declared a role's own "Disposition and working style"
# section — the section role authors actually write in — the winner over the
# shared prose rules. That is the inverse of the floor the worldview, the
# README and this preamble's own first paragraph all claim, and it reached
# every role in every compiled body. A role may still be more specific than the
# house prose and may narrow it; it may not outrank it.
PREAMBLE = """\
This is the persona layer. It shapes voice, judgment emphasis, and what you
notice. It never adds authority, relaxes a safety rule, changes a required
action, or replaces an output format. Those live in this CLAUDE.md and in the
skill, and they win every time.

Precedence: truth, then action, then the operational contract, then evidence,
then house prose, then role judgment, then role signature, then crew costume.
The shared worldview and house prose are the floor. A role voice or a crew
costume may narrow them for itself; neither may weaken, exempt itself from, or
override them, and where a role statement conflicts with a shared one the
shared one governs.
"""


# --------------------------------------------------------------------------- #
# paths
# --------------------------------------------------------------------------- #
def repo_root() -> str:
    return repo_root_of_script()


def read(path: str) -> str:
    # newline="" disables universal-newline translation. Without it a CRLF
    # target is silently normalised to LF on the way back out, which would
    # rewrite hand-written bytes OUTSIDE the generated markers — the one thing
    # install promises never to touch.
    with open(path, encoding="utf-8", newline="") as f:
        return f.read()


def write_atomic(path: str, text: str) -> None:
    """Replace a file's contents without ever leaving it truncated.

    These are operational-contract files and their load-bearing sidecars. A
    plain open(path, "w") truncates first, so an interrupt or a full disk
    leaves a session's CLAUDE.md empty. Write a sibling temp file, flush it to
    disk, then rename over the target: readers see the old bytes or the new
    ones, never a partial file. newline="" for the same reason as read().
    """
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".persona-compile.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


# --------------------------------------------------------------------------- #
# source normalisation
# --------------------------------------------------------------------------- #
def strip_title(text: str, demote: int = 1) -> tuple[str, str]:
    """Split a source file into (H1 title, body with headings demoted `demote` levels).

    Sources are authored as standalone documents (`# The tracker` / `## Signature`).
    The compiled file nests them, so every remaining heading drops to the depth of
    the section it lands under.

    Three things this is careful about, because the output is prompt text:

    - Fenced code blocks are left alone. A `# comment` inside a ```bash fence is
      a shell comment, not a heading, and promoting it corrupts the example.
    - Demotion clamps at H6. Markdown has no H7, so overflowing produces a line
      that renders as literal `#######` text.
    - HTML comments are dropped. That is what lets a template file carry
      instructions for the human editing it (see personas/roles/example.md)
      without those instructions becoming the compiled session's disposition.
    """
    text = HTML_COMMENT.sub("", text)
    lines = text.strip("\n").split("\n")
    title = ""
    if lines and lines[0].startswith("# "):
        title = lines[0][2:].strip()
        lines = lines[1:]
    while lines and not lines[0].strip():
        lines = lines[1:]

    out, in_fence = [], False
    for line in lines:
        if FENCE.match(line):
            in_fence = not in_fence
            out.append(line)
            continue
        m = None if in_fence else re.match(r"^(#{1,6}) (.*)$", line)
        if m:
            level = min(len(m.group(1)) + demote, 6)
            out.append("#" * level + " " + m.group(2))
        else:
            out.append(line)
    # Dropping comment blocks can leave a run of blank lines behind.
    body = re.sub(r"\n{3,}", "\n\n", "\n".join(out))
    return title, body.strip("\n")


def load_config(path: str) -> dict:
    with open(path, "rb") as f:
        return tomllib.load(f)


# The costume that means "this role wears none". A role must be able to stand
# with no surface treatment (gap audit P-07); before this, removal was refused
# outright and the only way to have no costume was to select an empty one.
NO_CREW = "none"

# The two keys every config must carry. Both are required on purpose —
# personas/config.example.toml states it and bin/test_persona_compile.py pins
# it — so a config that names neither cannot compile a role by accident.
BASE_KEYS = ("hub", "loop_crew")


def crew_for(role: str, cfg: dict, cfg_path: str = "config.toml") -> str:
    """The hub may wear a different signature from the loop crew.

    Two tiers, keyed off the role named `hub` — which is a structural concept of
    this repo (`hub/` is a top-level directory that `bin/ops up` starts), not an
    installation's identity. A per-role tier is a config-schema change, not a
    bug fix, so it is not made here; `loop_crew` remains the fallback.
    """
    key = "hub" if role == "hub" else "loop_crew"
    crew = cfg.get(key)
    if crew == NO_CREW:
        return crew
    if not isinstance(crew, str) or not crew:
        what = "is missing" if crew is None else "must be a crew name (a string), not"
        got = "" if crew is None else f" {type(crew).__name__}"
        raise SystemExit(f"persona-compile: {cfg_path} {what} `{key}`{got}")
    return crew


def check_config_keys(cfg: dict, roles: list) -> None:
    """Refuse a selection key that names no role (gap audit P-07).

    A key here is either one of the two base keys, a role name, or a mistake.
    Silently ignoring the third is what made a per-role selection look like it
    had worked.
    """
    known = set(BASE_KEYS) | set(roles)
    stray = sorted(k for k, v in cfg.items()
                   if isinstance(v, str) and k not in known)
    if stray:
        raise SystemExit(
            f"persona-compile: config.toml names "
            f"{', '.join(repr(k) for k in stray)}, which is neither a base key "
            f"({', '.join(BASE_KEYS)}) nor a role in personas/roles/. A "
            f"selection that names nothing is refused rather than ignored.")


def discover_roles(personas_dir: str) -> list[str]:
    d = os.path.join(personas_dir, "roles")
    if not os.path.isdir(d):
        raise SystemExit(f"persona-compile: no roles directory at {d}")
    roles = sorted(f[:-3] for f in os.listdir(d) if f.endswith(".md"))
    if not roles:
        raise SystemExit(f"persona-compile: no roles in {d}; at least one "
                         f"<role>.md is required (copy roles/example.md)")
    return roles


# --------------------------------------------------------------------------- #
# compile
# --------------------------------------------------------------------------- #
def compile_role(role: str, personas_dir: str, cfg: dict, cfg_path: str = "config.toml") -> dict:
    """Resolve one role into its compiled body. Returns a record for the manifest."""
    crew = crew_for(role, cfg, cfg_path)
    bare = crew == NO_CREW
    paths = {
        "worldview": os.path.join(personas_dir, "WORLDVIEW.md"),
        "house": os.path.join(personas_dir, "HOUSE_STYLE.md"),
        "role": os.path.join(personas_dir, "roles", f"{role}.md"),
    }
    if not bare:
        paths["crew"] = os.path.join(personas_dir, "crews", f"{crew}.md")
    for what, p in paths.items():
        if not os.path.isfile(p):
            raise SystemExit(f"persona-compile: role '{role}' needs {what} at {p}, "
                             f"which does not exist")

    src = {k: read(p) for k, p in paths.items()}
    # Role bodies carry their own `## Disposition` / `## Signature` headings and
    # land one level deeper than the rest, so they drop two levels, not one.
    _, wv = strip_title(src["worldview"])
    _, hs = strip_title(src["house"])
    role_title, role_body = strip_title(src["role"], demote=2)
    crew_title, crew_body = ("", "") if bare else strip_title(src["crew"])

    display = role_title or role
    src_line = " ".join(
        f"{os.path.relpath(paths[k], personas_dir)}@{sha256(src[k])[:12]}"
        for k in ("worldview", "house", "role", "crew") if k in paths)

    body_parts = [
        f"## Persona — {display}",
        "",
        PREAMBLE.rstrip("\n"),
        "",
        "### Shared worldview",
        "",
        wv,
        "",
        "### House prose",
        "",
        hs,
        "",
        f"### Role — {display}",
        "",
        role_body,
        "",
    ]
    if not bare:
        body_parts += [f"### Crew — {crew_title or crew}", "", crew_body, ""]
    body = "\n".join(body_parts)
    return {
        "role": role,
        "display": display,
        "crew": crew,
        "body": body,
        "sha": sha256(body),
        "sources": src_line,
    }


def compiled_file(rec: dict) -> str:
    """The standalone personas/compiled/<role>.md rendering of a body."""
    return "\n".join([
        "<!-- GENERATED by bin/persona-compile — DO NOT EDIT. "
        "Edit personas/ sources and recompile. -->",
        f"<!-- role={rec['role']} crew={rec['crew']} sha256={rec['sha'][:12]} -->",
        f"<!-- sources: {rec['sources']} -->",
        "",
        f"# Compiled persona — {rec['display']}",
        "",
        rec["body"],
    ])


def block(rec: dict) -> str:
    """The generated block installed into a live CLAUDE.md.

    It is a POINTER, not the body: a `@`-import of the sidecar written next to
    the target (see sidecar_path). The harness resolves `@` at injection time,
    so the body still arrives in the prompt at startup and after compaction —
    the property that makes this safe at all — while the body itself stays in
    its own file, separately reviewable and updateable.

    Keeping CLAUDE.md byte-stable across recompiles is the point: only the
    sidecar changes when a persona changes, so a recompile no longer shows up
    as a diff in an operational-contract file (or as extraction drift on one).

    Note what is NOT here: the crew and the content hash. Those live in the
    sidecar's own header. If the stamp were here, every persona edit would
    still rewrite CLAUDE.md and the decoupling would buy nothing. Only `role`
    survives, because which persona a file wears is a property of the target
    (config.toml `[targets]`), not of the persona's content — so this block
    changes only when a target is deliberately re-pointed at another role."""
    return "\n".join([
        f"{BEGIN} · role={rec['role']} -->",
        "<!-- Do not edit inside these markers, and do not edit the "
        f"{SIDECAR} it points at. Edit personas/ and run "
        "bin/persona-compile --install. -->",
        "",
        f"@{SIDECAR}",
        "",
        END,
    ])


def sidecar_path(repo: str, target_rel: str) -> str:
    """Where a target's persona body lives: a sibling of its CLAUDE.md.

    It MUST be a sibling. A `@`-import only resolves at or below the session's
    own directory — `@../../personas/compiled/<role>.md` and an absolute path
    both silently import nothing — no error, just a session wearing no persona.
    See docs/personas.md. personas/compiled/<role>.md is the deterministic
    artifact `--check` compares against — nothing reads it at install time and
    it is gitignored, so it is a comparand rather than a review surface; this
    is the installed copy, the same body under a name the import can reach."""
    return os.path.join(repo, os.path.dirname(target_rel), SIDECAR)


def sidecar(rec: dict) -> str:
    """The generated sidecar body imported by a target's CLAUDE.md.

    The header carries the PER-SOURCE revisions as well as the composite body
    hash — gap audit P-04. The vocabulary already existed and simply never
    reached the installed side: `personas/compiled/<role>.md:3` has carried
    `sources: WORLDVIEW.md@… HOUSE_STYLE.md@…` since v1, while the installed
    sidecar carried one combined hash and the block inside CLAUDE.md carried
    only `role=`. An evaluator demonstrated the cost directly: a bare compile
    rewrote the compiled file to the new sources while the installed sidecar
    still held the old body hash, after which no file anywhere recorded what
    the installed set was built from.

    It goes here and NOT into the target CLAUDE.md, which keeps that file
    byte-stable across a persona edit — the constraint that shaped the sidecar
    split in the first place, and one this preserves rather than trades away.
    """
    return "\n".join([
        f"<!-- GENERATED by bin/persona-compile — DO NOT EDIT. "
        f"role={rec['role']} · crew={rec['crew']} · sha256={rec['sha'][:12]} -->",
        f"<!-- sources: {rec['sources']} -->",
        "<!-- Source: personas/. Change a persona there and run "
        "bin/persona-compile --install. -->",
        "",
        rec["body"].rstrip("\n"),
        "",
    ])


def manifest(recs: list[dict], targets: dict) -> str:
    lines = [
        "<!-- GENERATED by bin/persona-compile — DO NOT EDIT. -->",
        "",
        "# Compiled persona manifest",
        "",
        "The auditable record of what each session is wearing. `sha256` is the",
        "hash of the compiled body. It is stamped into the persona.md sidecar",
        "beside each target, together with the per-source revisions below, and",
        "deliberately NOT into the target CLAUDE.md — which carries only",
        "`role=`, so that a persona edit leaves an operational-contract file",
        "byte-stable. `bin/persona-compile --check` fails when a compiled file,",
        "an installed block or a sidecar no longer matches these sources.",
        "",
    ]
    for rec in recs:
        lines += [
            f"## {rec['role']}",
            "",
            f"- display name: {rec['display']}",
            f"- crew: {rec['crew']}",
            f"- sha256: {rec['sha']}",
            f"- target: {targets.get(rec['role'], '(not installed)')}",
            f"- sources: {rec['sources']}",
            "",
        ]
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# what a RUNNING role is wearing (gap audit P-01)
# --------------------------------------------------------------------------- #
# `--check` compares files to files. That is a real question and it is not the
# question "is the voice the operator just landed the voice anybody is speaking in".
#
# It is named here by JOINING two answers that already exist rather than by
# building a second reporting path:
#
#   the running side   an installation skill-drift adapter already derives, per loop, the instant
#                      its tmux session bound its files — the one ground truth
#                      that a restart moves and a kick does not. Its rows carry
#                      `dir`, which is the directory a persona target lives in,
#                      so the join key is the directory and nothing new is
#                      derived about sessions here.
#   the persona side   the newest commit on the branch touching THIS role's own
#                      installed sidecar. Deliberately the sidecar and not the
#                      compiled file or the sources: the sidecar is the file the
#                      target CLAUDE.md imports, so it is what a session reads.
#
# Three verdicts, and `current` is the absence claim — "no persona commit landed
# after this session bound its files" — so it is reachable only where the
# running side actually answered. Anything skill-drift could not observe, any
# role with no target, any sidecar with no history: `unknown`, never a soft
# `current` and never a soft `superseded` (docs/absence-contract.md).
#
# Report-only, and that is the deliberate half of P-01's decision. The manual
# restart is a design decision stated in three places (this file's own module
# docstring, personas/README.md, personas/config.toml) and nothing here removes
# it. What was missing was anything that NAMED the window; `--wearing` names it
# and prints the restart command an installation skill-drift adapter already composes.
CURRENT = "current"
SUPERSEDED = "superseded"
UNKNOWN = "unknown"
WEARING_VERDICTS = (SUPERSEDED, UNKNOWN, CURRENT)
WEARING_EXIT = {CURRENT: 0, UNKNOWN: 2, SUPERSEDED: 3}


def read_skill_drift(repo: str, fixture: str | None) -> tuple[dict | None, str]:
    """`an installation skill-drift adapter --json` as data, plus why it could not be read.

    skill-drift exits 3 when something is stale and 2 when something is
    unobservable. Both are ordinary answers here — a stale row is exactly the
    row this report exists to name — so only a missing payload is a failure.
    """
    if fixture is not None:
        try:
            with open(fixture, encoding="utf-8") as f:
                return json.loads(f.read()), ""
        except OSError as exc:
            return None, f"--skill-drift-json {fixture} could not be read ({exc.strerror})"
        except ValueError:
            return None, f"--skill-drift-json {fixture} is not JSON"

    helper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "skill-drift")
    if not os.path.isfile(helper):
        return None, f"an installation skill-drift adapter is not at {helper}, so no running session can be read"
    try:
        out = subprocess.run([sys.executable, helper, "--repo", repo, "--json"],
                             capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, f"an installation skill-drift adapter did not return ({exc.__class__.__name__})"
    if not (out.stdout or "").strip():
        return None, (f"an installation skill-drift adapter exited {out.returncode} with no JSON: "
                      f"{(out.stderr or '').strip()[:160]}")
    try:
        return json.loads(out.stdout), ""
    except ValueError:
        return None, "an installation skill-drift adapter's answer was not JSON"


def _git(repo: str, *argv) -> str | None:
    try:
        out = subprocess.run(["git", "-C", repo, *argv], capture_output=True,
                             text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def sidecar_history(repo: str, branch: str, rel_path: str) -> dict | None:
    """The newest commit on `branch` touching this role's installed sidecar."""
    raw = _git(repo, "log", "-n1", "--format=%H%x1f%ct%x1f%s", branch, "--", rel_path)
    if raw is None:
        return None
    line = raw.splitlines()[0] if raw.splitlines() else ""
    sha, _, rest = line.partition("\x1f")
    ct, _, subject = rest.partition("\x1f")
    if not sha:
        return {}
    try:
        at = dt.datetime.fromtimestamp(float(ct), dt.timezone.utc)
    except (TypeError, ValueError, OverflowError, OSError):
        return {}
    return {"sha": sha, "at": at, "subject": subject}


def wearing_rows(recs: list[dict], targets: dict, repo: str, branch: str,
                 drift: dict | None, drift_error: str,
                 installed_stale: set) -> list[dict]:
    """One row per compiled role: what is on disk, and what is being worn.

    `drift` is a `an installation skill-drift adapter --json` payload. `installed_stale` is the set
    of role names whose sidecar on disk does not match the sources — a role can
    be wearing a superseded voice AND have an out-of-date file to restart into,
    and those are two different sentences.
    """
    by_dir = {}
    for row in (drift or {}).get("rows", []):
        by_dir[row.get("dir")] = row

    rows = []
    for rec in recs:
        role = rec["role"]
        target = targets.get(role)
        out = {"role": role, "display": rec["display"], "target": target,
               "sidecar": None, "verdict": UNKNOWN, "why": None,
               "bound_at": None, "latest": None, "session": None,
               "installed": "stale" if role in installed_stale else "current",
               "restart": None}
        if not target:
            out["why"] = ("no target in config.toml [targets], so no session "
                          "reads this role at all")
            out["installed"] = "not installed"
            rows.append(out)
            continue

        target_dir = os.path.dirname(target) or "."
        out["sidecar"] = os.path.join(target_dir, SIDECAR)
        row = by_dir.get(target_dir)
        if row is None:
            out["why"] = (drift_error or
                          f"an installation skill-drift adapter reports no session for {target_dir}/, "
                          f"so nothing says what it bound")
            rows.append(out)
            continue

        out["session"] = row.get("title")
        out["restart"] = row.get("restart_command")
        bound = row.get("bound_at")
        if not bound:
            reading = row.get("reading") or {}
            out["why"] = (reading.get("why") or
                          f"an installation skill-drift adapter returned `{row.get('verdict')}` for "
                          f"{target_dir}/ with no binding time")
            rows.append(out)
            continue
        try:
            bound_at = dt.datetime.fromisoformat(bound)
        except ValueError:
            out["why"] = f"an installation skill-drift adapter's bound_at for {target_dir}/ would not parse"
            rows.append(out)
            continue
        out["bound_at"] = bound_at

        hist = sidecar_history(repo, branch, out["sidecar"])
        if hist is None:
            out["why"] = (f"git log would not answer for {out['sidecar']} on "
                          f"{branch}")
            rows.append(out)
            continue
        if not hist:
            out["why"] = (f"no commit on {branch} has ever touched "
                          f"{out['sidecar']}, so there is no installed voice to "
                          f"compare a session against")
            rows.append(out)
            continue
        out["latest"] = hist
        out["verdict"] = SUPERSEDED if hist["at"] > bound_at else CURRENT
        rows.append(out)
    return rows


def wearing_tally(rows: list[dict]) -> dict:
    counts = {CURRENT: 0, SUPERSEDED: 0, UNKNOWN: 0}
    for row in rows:
        counts[row["verdict"]] = counts.get(row["verdict"], 0) + 1
    return counts


def _stamp(when) -> str:
    return "—" if when is None else when.astimezone().strftime("%Y-%m-%d %H:%M")


def render_wearing(rows: list[dict], branch: str, drift_error: str) -> str:
    counts = wearing_tally(rows)
    lines = [
        f"what each running role is wearing · branch {branch}",
        f"{counts[CURRENT]} current · {counts[SUPERSEDED]} SUPERSEDED · "
        f"{counts[UNKNOWN]} unknown",
        "",
    ]
    if drift_error:
        lines += [f"   [?????] an installation skill-drift adapter  {drift_error}", ""]

    for verdict, title in (
            (SUPERSEDED, "the session is reading an older voice than the "
                         "branch installs"),
            (UNKNOWN, "what the session is reading could not be determined"),
            (CURRENT, "the session bound at or after the newest persona "
                      "commit")):
        group = [r for r in rows if r["verdict"] == verdict]
        if not group:
            continue
        lines.append(f"── {verdict} ({len(group)}) — {title}")
        for row in group:
            head = f"{verdict:<12} {row['role']:<12}"
            if verdict == UNKNOWN:
                lines.append(f"{head} — {row['why']}")
                continue
            latest = row["latest"]
            lines.append(
                f"{head} — bound {_stamp(row['bound_at'])}; "
                f"{row['sidecar']} last moved {latest['sha'][:7]} "
                f"\"{latest['subject'][:52]}\" ({_stamp(latest['at'])})")
            if verdict == SUPERSEDED and row["restart"]:
                lines.append("             → " + row["restart"])
            if row["installed"] == "stale":
                lines.append("             ! the file on disk is itself out of "
                             "date — run --install before restarting")
        lines.append("")

    lines += [
        "── what this does and does not say",
        "   `current` means no commit touching that role's installed sidecar "
        "landed after its",
        "   session bound its files. It does NOT mean the session re-read "
        "anything, and a session",
        "   told the new voice by hand still reads `current` here — the same "
        "safe direction",
        "   an installation skill-drift adapter takes. `unknown` is never a soft `current`: a "
        "session that is not",
        "   running, a target with no session and an unreadable history all "
        "produce the same",
        "   empty answer as a role that is genuinely up to date "
        "(docs/absence-contract.md).",
        "",
        "   Applying a persona is still a deliberate restart, by hand, one "
        "session at a time.",
        "   This names the window between installing a voice and anybody "
        "speaking it; it does",
        "   not close it.",
    ]
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------- #
# the three role states (gap audit P-13) and the bound set (P-10)
# --------------------------------------------------------------------------- #
# The report used to be a per-file drift list plus one global word. A matching
# role was named by the ABSENCE of a line, which is the same signal as a role
# the report never reached; roles appeared only inside file paths; one row
# (MANIFEST.md) belonged to no role at all; and one role could carry two state
# words at once — an evaluator produced a mechanic reported `stale` and
# `missing` simultaneously. There were at least five state words, two of which
# were neither matching, nor not-matching, nor nothing-installed: a target that
# does not exist, and a target with no generated markers, the latter also
# skipping the sidecar check entirely.
#
# Every role lands in exactly one of three now. The per-file lines stay, because
# they are genuinely more useful when FIXING a drift — the answer here was both,
# not a replacement.
MATCHING = "matching"
NOT_MATCHING = "not-matching"
NOTHING_INSTALLED = "nothing-installed"
ROLE_STATES = (NOT_MATCHING, NOTHING_INSTALLED, MATCHING)

def role_states(recs: list, targets: dict, repo: str, out_dir: str,
                check_installed: bool) -> list:
    """One state per role, and the reasons behind it.

    `nothing-installed` covers every way a role reaches no session: no target in
    [targets], a target file that does not exist, and a target with no generated
    markers — the pointer is not there, so nothing is installed, whatever else
    is true of the file.
    """
    rows = []
    for rec in recs:
        row = {"role": rec["role"], "state": MATCHING, "reasons": [],
               "target": targets.get(rec["role"])}

        path = os.path.join(out_dir, f"{rec['role']}.md")
        have = read(path) if os.path.isfile(path) else None
        if have != compiled_file(rec):
            row["state"] = NOT_MATCHING
            row["reasons"].append(
                f"{os.path.relpath(path, repo)} is "
                f"{'stale' if have else 'missing'}")

        rel = row["target"]
        if not rel:
            row["state"] = NOTHING_INSTALLED
            row["reasons"].append("no target in config.toml [targets]")
            rows.append(row)
            continue
        if not check_installed:
            rows.append(row)
            continue

        target = os.path.join(repo, rel)
        if not os.path.isfile(target):
            row["state"] = NOTHING_INSTALLED
            row["reasons"].append(f"{rel} does not exist")
            rows.append(row)
            continue
        text = read(target)
        try:
            installed = current_block(text)
        except ValueError as exc:
            row["state"] = NOT_MATCHING
            row["reasons"].append(str(exc))
            rows.append(row)
            continue
        if installed is None:
            row["state"] = NOTHING_INSTALLED
            row["reasons"].append(f"{rel} has no generated-persona markers")
            rows.append(row)
            continue
        if current_block(text) != block(rec):
            row["state"] = NOT_MATCHING
            row["reasons"].append(f"{rel} installed block is stale")

        spath = sidecar_path(repo, rel)
        srel = os.path.relpath(spath, repo)
        shave = read(spath) if os.path.isfile(spath) else None
        if shave is None:
            row["state"] = NOTHING_INSTALLED
            row["reasons"].append(f"{srel} is missing")
        elif shave != sidecar(rec):
            if row["state"] != NOTHING_INSTALLED:
                row["state"] = NOT_MATCHING
            row["reasons"].append(f"{srel} is stale")
        rows.append(row)
    return rows


def installed_revisions(repo: str, rel: str) -> dict:
    """The per-source revisions the installed sidecar records (gap audit P-04).

    Empty when the sidecar is absent or predates the stamp, which the report
    prints as "not recorded" rather than as agreement.
    """
    spath = sidecar_path(repo, rel)
    if not os.path.isfile(spath):
        return {}
    out = {}
    for line in read(spath).split("\n")[:6]:
        if "sources:" not in line:
            continue
        for label, rev in re.findall(r"([\w./-]+\.md)@([0-9a-f]{6,64})", line):
            out[label] = rev
    return out






# --------------------------------------------------------------------------- #
# install / check
# --------------------------------------------------------------------------- #
def replace_block(text: str, new_block: str) -> str:
    """Swap the generated block in a target file. Markers must already exist."""
    span = marker_span(text)
    if span is None:
        raise ValueError("no generated-persona markers")
    start, end = span
    return text[:start] + new_block + text[end:]


def current_block(text: str) -> str | None:
    span = marker_span(text)
    if span is None:
        return None
    start, end = span
    return text[start:end]


def contained(repo: str, path: str) -> bool:
    """Is `path` inside the repo? Config values must not be able to escape it.

    os.path.join drops `repo` entirely when handed an absolute component, and
    never collapses `..`, so an unvalidated [targets] value rewrites files
    anywhere on the filesystem. Compared on realpath so a symlinked target is
    judged by where the write actually lands.
    """
    root = os.path.realpath(repo)
    return os.path.realpath(path) == root or \
        os.path.realpath(path).startswith(root + os.sep)

def validate_targets(repo: str, targets: dict, roles: list[str],
                     cfg_path: str) -> None:
    """Reject a [targets] table before anything is written, not partway through."""
    for name, rel in sorted(targets.items()):
        if name not in roles:
            raise SystemExit(f"persona-compile: {cfg_path} [targets] names "
                             f"'{name}', which has no personas/roles/{name}.md")
        if not isinstance(rel, str) or not rel:
            raise SystemExit(f"persona-compile: {cfg_path} [targets] {name} must "
                             f"be a path relative to the repo root")
        if os.path.isabs(rel) or not contained(repo, os.path.join(repo, rel)):
            raise SystemExit(f"persona-compile: {cfg_path} [targets] {name} = "
                             f"'{rel}' resolves outside the repo; targets are "
                             f"relative to the repo root")

    # One fixed sidecar name per directory. Two targets sharing a directory
    # overwrite each other's body, and no --install ever makes --check clean —
    # so say so now rather than exiting 0 on wiring that cannot converge.
    seen: dict[str, str] = {}
    for name, rel in sorted(targets.items()):
        spath = os.path.realpath(sidecar_path(repo, rel))
        if spath in seen:
            raise SystemExit(
                f"persona-compile: {cfg_path} [targets] {seen[spath]} and {name} "
                f"both resolve to {os.path.relpath(spath, repo)}; each target "
                f"needs its own directory, since the sidecar name is fixed")
        seen[spath] = name

def uncode(text: str) -> str:
    """Blank out fenced code blocks, keeping line count so offsets still line up.

    Documentation quotes these markers — docs/personas.md shows the pair a
    target needs, and the loops describe them in prose. A scanner that cannot
    tell a documented marker from an installed one reports the documentation as
    a stray persona, which is the same class of mistake as splicing on a
    first-match find.
    """
    out, in_fence = [], False
    for line in text.split("\n"):
        if FENCE.match(line):
            in_fence = not in_fence
            out.append("")
        else:
            out.append("" if in_fence else line)
    return "\n".join(out)

def installed_blocks(repo: str) -> list[tuple[str, str | None]]:
    """Every file in the repo carrying a generated block, with the role it names.

    --check otherwise only ever looks at what the config currently selects, so
    dropping a role from [targets] leaves its block and body in place, worn by
    a live session, and reports clean forever. The one transient signal (a
    stale MANIFEST.md) is extinguished by the next --install.
    """
    found = []
    for base, dirs, files in os.walk(repo):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for name in sorted(files):
            if not name.endswith(".md"):
                continue
            path = os.path.join(base, name)
            if os.path.islink(path):
                continue  # the link's target is walked on its own
            try:
                text = uncode(read(path))
            except (OSError, UnicodeDecodeError):
                continue
            if BEGIN not in text:
                continue
            m = re.search(re.escape(BEGIN) + r"\s*·\s*role=([^\s]+)", text)
            found.append((os.path.relpath(path, repo), m.group(1) if m else None))
    return found

def marker_span(text: str) -> tuple[int, int] | None:
    """Locate the one generated block in a target, or explain why there isn't one.

    Returns (start, end-of-END) for exactly one well-formed pair. Raises
    ValueError when the file has markers but not a usable pair, and returns
    None only when it has none at all.

    Uniqueness is the point. Taking the first `find` of each marker
    independently is wrong in two directions, and both are silent: a stray or
    quoted BEGIN ahead of the real block makes the replacement swallow every
    hand-written line between them, and a second complete pair is left live in
    the prompt while a check that only compared the first reports clean. A
    target that mentions the markers in prose is a real thing — the loops
    document them — so this refuses rather than guesses.
    """
    starts = [m.start() for m in re.finditer(re.escape(BEGIN), text)]
    ends = [m.start() for m in re.finditer(re.escape(END), text)]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1:
        raise ValueError(
            f"expected exactly one generated-persona marker pair, found "
            f"{len(starts)} BEGIN and {len(ends)} END")
    if ends[0] < starts[0]:
        raise ValueError("generated-persona END marker precedes its BEGIN")
    return starts[0], ends[0] + len(END)

def run(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="persona-compile", add_help=True)
    ap.add_argument("--repo", default=repo_root())
    ap.add_argument("--personas-dir")
    ap.add_argument("--config")
    ap.add_argument("--out")
    ap.add_argument("--role", action="append",
                    help="restrict to this role (repeatable)")
    ap.add_argument("--check", action="store_true",
                    help="verify compiled files and installed blocks; exit 1 on drift")
    ap.add_argument("--install", action="store_true",
                    help="refresh the generated block in each target CLAUDE.md")
    ap.add_argument("--print", dest="print_role",
                    help="write one compiled body to stdout and exit")
    ap.add_argument("--wearing", action="store_true",
                    help="report what each RUNNING role is reading (gap audit "
                         "P-01); joins an installation skill-drift adapter's binding times to this "
                         "branch's persona history. Exit 3 superseded, 2 "
                         "unknown")
    ap.add_argument("--branch", default="main",
                    help="the branch a running session is judged against "
                         "(--wearing only; default: main)")
    ap.add_argument("--skill-drift-json", default=None,
                    help="read `an installation skill-drift adapter --json` from this file instead "
                         "of running it (--wearing only)")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args(argv)
    if args.print_role and (args.check or args.install or args.wearing):
        ap.error("--print cannot be combined with --check, --install or --wearing")
    if args.check and args.install:
        ap.error("--check and --install are mutually exclusive")

    repo = os.path.abspath(args.repo)
    personas_dir = args.personas_dir or os.path.join(repo, "personas")
    cfg_path = args.config or os.path.join(personas_dir, "config.toml")
    out_dir = args.out or os.path.join(personas_dir, "compiled")
    if not os.path.isfile(cfg_path):
        raise SystemExit(f"persona-compile: no config at {cfg_path}")
    cfg = load_config(cfg_path)
    targets = cfg.get("targets", {})
    if not isinstance(targets, dict):
        raise SystemExit(f"persona-compile: {cfg_path} [targets] must be a table")

    roles = discover_roles(personas_dir)
    unknown = [r for r in (args.role or []) if r not in roles]
    if unknown:
        raise SystemExit(f"persona-compile: unknown role(s): {', '.join(unknown)}. "
                         f"known: {', '.join(roles)}")
    for name in targets:
        if name not in roles:
            raise SystemExit(f"persona-compile: config.toml [targets] names "
                             f"'{name}', which has no personas/roles/{name}.md")
    validate_targets(repo, targets, roles, cfg_path)
    check_config_keys(cfg, roles)
    if args.role:
        roles = [r for r in roles if r in args.role]

    recs = [compile_role(r, personas_dir, cfg, cfg_path) for r in roles]

    if args.print_role:
        match = [r for r in recs if r["role"] == args.print_role]
        if not match:
            raise SystemExit(f"persona-compile: no compiled role '{args.print_role}'")
        sys.stdout.write(match[0]["body"])
        return 0

    if args.wearing:
        # Read-only, and deliberately its own path: it writes nothing, compiles
        # nothing, and never touches a target. It asks the other question.
        stale = set()
        for rec in recs:
            rel = targets.get(rec["role"])
            if not rel:
                continue
            spath = sidecar_path(repo, rel)
            have = read(spath) if os.path.isfile(spath) else None
            if have != sidecar(rec):
                stale.add(rec["role"])
        payload, why = read_skill_drift(repo, args.skill_drift_json)
        rows = wearing_rows(recs, targets, repo, args.branch, payload, why,
                            stale)
        if not args.quiet:
            sys.stdout.write(render_wearing(rows, args.branch, why))
        counts = wearing_tally(rows)
        if counts[SUPERSEDED]:
            return 3
        if counts[UNKNOWN]:
            return 2
        return 0

    drift: list[str] = []

    # personas/compiled/<role>.md
    for rec in recs:
        path = os.path.join(out_dir, f"{rec['role']}.md")
        want = compiled_file(rec)
        if args.check:
            have = read(path) if os.path.isfile(path) else None
            if have != want:
                drift.append(f"{os.path.relpath(path, repo)} is stale"
                             if have else
                             f"{os.path.relpath(path, repo)} is missing")
        else:
            write_atomic(path, want)

    # Nothing else enumerates the output directory, so a role that was renamed
    # or removed leaves its compiled file behind under a clean report.
    if args.check and not args.role and os.path.isdir(out_dir):
        expected = {f"{rec['role']}.md" for rec in recs} | {"MANIFEST.md"}
        for name in sorted(os.listdir(out_dir)):
            if name.endswith(".md") and name not in expected:
                drift.append(f"{os.path.relpath(os.path.join(out_dir, name), repo)} "
                             f"is orphaned (no personas/roles/{name})")

    # MANIFEST.md — only meaningful for a full compile
    if not args.role:
        mpath = os.path.join(out_dir, "MANIFEST.md")
        want = manifest(recs, targets)
        if args.check:
            have = read(mpath) if os.path.isfile(mpath) else None
            if have != want:
                drift.append(f"{os.path.relpath(mpath, repo)} is "
                             f"{'stale' if have else 'missing'}")
        else:
            write_atomic(mpath, want)

    # Installed blocks in the live CLAUDE.md files. A bare compile only refreshes
    # personas/compiled/; wiring a target is a deliberate --install / --check.
    for rec in recs:
        rel = targets.get(rec["role"])
        if not rel or not (args.check or args.install):
            continue
        path = os.path.join(repo, rel)
        if not os.path.isfile(path):
            drift.append(f"{rel} (target for role '{rec['role']}') does not exist")
            continue
        text = read(path)
        want = block(rec)
        try:
            have = current_block(text)
        except ValueError as exc:
            drift.append(f"{rel} has malformed generated-persona markers: {exc}")
            continue
        if have is None:
            drift.append(f"{rel} has no generated-persona markers "
                         f"(add them once, then --install)")
            continue
        if args.check:
            if have != want:
                drift.append(f"{rel} installed block is stale")
        elif args.install and have != want:
            write_atomic(path, replace_block(text, want))

        # The sidecar the block imports. Written even when the block itself is
        # already current: the block only carries the sha, so an out-of-date
        # body behind an up-to-date pointer is exactly the drift to catch.
        spath = sidecar_path(repo, rel)
        swant = sidecar(rec)
        srel = os.path.relpath(spath, repo)
        if args.check:
            shave = read(spath) if os.path.isfile(spath) else None
            if shave != swant:
                drift.append(f"{srel} is {'stale' if shave else 'missing'}")
        elif args.install and (read(spath) if os.path.isfile(spath) else None) != swant:
            write_atomic(spath, swant)

    # A block on disk whose role is no longer in [targets] is a session still
    # wearing a persona nothing selects. Only a full pass can say that, since
    # --role deliberately narrows what is known.
    if args.check and not args.role:
        for rel, role in installed_blocks(repo):
            if role is None:
                drift.append(f"{rel} has a generated-persona block with no role= stamp")
            elif role not in targets:
                drift.append(f"{rel} still installs role '{role}', which is not in "
                             f"[targets] (re-add it, or remove the block and its "
                             f"{SIDECAR})")

    # ── every role in exactly one state (P-13) + the bound set (P-10) ────── #
    if args.check or args.install:
        states = role_states(recs, targets, repo, out_dir,
                             check_installed=True)
        if not args.quiet:
            print()
            for row in sorted(states,
                              key=lambda r: (ROLE_STATES.index(r["state"]),
                                             r["role"])):
                head = f"{row['state']:<18} {row['role']:<12}"
                if row["state"] == MATCHING:
                    recorded = installed_revisions(repo, row["target"] or "")
                    print(f"{head} {row['target'] or '(no target)'}")
                    for rec in recs:
                        if rec["role"] != row["role"]:
                            continue
                        for piece in rec["sources"].split():
                            label, _, current = piece.partition("@")
                            was = recorded.get(label, "not recorded")
                            mark = "=" if was == current else "≠"
                            print(f"                     {label:<26} "
                                  f"installed {was:<14} {mark} current "
                                  f"{current}")
                else:
                    print(f"{head} {'; '.join(row['reasons'])}")
            print()

    if not args.quiet:
        for rec in recs:
            tgt = targets.get(rec["role"], "-")
            print(f"{rec['role']:<12} crew={rec['crew']:<18} "
                  f"sha256={rec['sha'][:12]}  {tgt}")
        if args.check:
            print("check: drift" if drift else "check: clean")
            # `--check` compares files to files and cannot say whether any
            # running session has read them. Naming its own limit is the
            # cheap half of gap-audit P-01; `--wearing` is the answer.
            print("(files only — bin/persona-compile --wearing says what the "
                  "running roles are actually reading)")

    if drift:
        for d in drift:
            print(f"DRIFT {d}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(run())
