#!/usr/bin/env bash
# dashboard-refresh — keep the live dashboard's served files fresh.
#
# Runs the deterministic, token-free `bin/dashboard --json` (no model, no agent,
# no loop-state writes) every REFRESH_S seconds. That one run rewrites all four
# served files from a single snapshot: state/dashboard.json and the three HTML
# shells, state/index.html, state/estate.html and state/dashboard-v2.html. The
# shells were on a manual `bin/dashboard-index` before, so a merged
# rendering change could sit invisible on the served page indefinitely. Being
# data-free did not cover that — it is the served MARKUP this keeps current,
# and dashboard.json that keeps the served numbers current.
#
# This is the regenerator half of the Tier-1 local dashboard; the server half is
# bin/dashboard-server. Install/start both with:
#     bin/ops dashboard up
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REFRESH_S="${DASHBOARD_REFRESH_S:-45}"

echo "dashboard-refresh: bin/dashboard --json (json + all three shells) every ${REFRESH_S}s" >&2
while :; do
  if ! "$REPO/bin/dashboard" --json >/dev/null 2>&1; then
    echo "dashboard-refresh: regen failed (transient) — retrying" >&2
  fi
  sleep "$REFRESH_S"
done
